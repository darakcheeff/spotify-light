import { Theme } from "../theme.slint";

export component LoginDialog inherits Rectangle {
    background: #000000d0;
    
    in-out property <int> auth_step: 0; // 0: Email, 1: Password or OTP Code
    in-out property <string> email: "";
    in-out property <string> password: "";
    in-out property <string> otp_code: "";
    in-out property <bool> is_otp_mode: false;
    in-out property <string> error_message: "";
    in-out property <bool> is_loading: false;

    callback submit_email(string);
    callback submit_password(string, string);
    callback submit_otp(string, string);
    callback login_via_browser();
    callback cancel();

    // Dialog Card
    Rectangle {
        width: 440px;
        height: 520px;
        background: Theme.background-secondary;
        border-radius: Theme.radius-large;
        border-width: 1px;
        border-color: Theme.border-color;

        VerticalLayout {
            padding: 36px;
            spacing: 18px;
            alignment: center;

            // Header
            Text {
                text: "🎧 SpotifyLight";
                color: Theme.accent;
                font-size: 26px;
                font-weight: 800;
                horizontal-alignment: center;
            }

            Text {
                text: root.auth_step == 0 ? "Вход в аккаунт" : (root.is_otp_mode ? "Введите код из письма" : "Введите пароль");
                color: Theme.text-primary;
                font-size: 18px;
                font-weight: 700;
                horizontal-alignment: center;
            }

            // Error banner
            if root.error_message != "" : Rectangle {
                height: 38px;
                border-radius: 4px;
                background: #e11d4833;
                border-width: 1px;
                border-color: #e11d48;
                Text {
                    text: root.error_message;
                    color: #fda4af;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Step 0: Input Email
            if root.auth_step == 0 : VerticalLayout {
                spacing: 16px;

                Text { text: "Электронная почта или имя пользователя"; color: Theme.text-secondary; font-size: 12px; }

                Rectangle {
                    height: 44px;
                    border-radius: 4px;
                    background: Theme.background-elevated;
                    border-width: 1px;
                    border-color: email_inp.has-focus ? Theme.text-primary : Theme.border-color;

                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px;
                        email_inp := TextInput {
                            text <=> root.email;
                            color: Theme.text-primary;
                            font-size: 14px;
                            vertical-alignment: center;
                            accepted => {
                                if root.email != "" {
                                    root.auth_step = 1;
                                    root.error_message = "";
                                    root.submit_email(root.email);
                                } else {
                                    root.error_message = "Введите адрес эл. почты или имя пользователя";
                                }
                            }
                        }
                    }
                }

                // Button "Продолжить"
                Rectangle {
                    height: 44px;
                    border-radius: 22px;
                    background: cont_touch.has-hover ? Theme.accent-hover : Theme.accent;

                    Text {
                        text: "Продолжить";
                        color: #000000;
                        font-size: 14px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    cont_touch := TouchArea {
                        clicked => {
                            if root.email != "" {
                                root.auth_step = 1;
                                root.error_message = "";
                                root.submit_email(root.email);
                            } else {
                                root.error_message = "Введите адрес эл. почты или имя пользователя";
                            }
                        }
                    }
                }

                // Alternative: Web browser login (PKCE)
                Rectangle {
                    height: 40px;
                    border-radius: 20px;
                    border-width: 1px;
                    border-color: Theme.text-secondary;
                    background: oauth_touch.has-hover ? Theme.background-elevated : transparent;

                    Text {
                        text: "Войти через браузер (OAuth)";
                        color: Theme.text-primary;
                        font-size: 13px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    oauth_touch := TouchArea {
                        clicked => {
                            root.error_message = "";
                            root.is_loading = true;
                            root.login_via_browser();
                        }
                    }
                }
            }

            // Step 1: Input Password or Email OTP Code
            if root.auth_step == 1 : VerticalLayout {
                spacing: 14px;

                HorizontalLayout {
                    Text { text: "Аккаунт: "; color: Theme.text-secondary; font-size: 12px; }
                    Text { text: root.email; color: Theme.text-primary; font-size: 12px; font-weight: 700; }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 80px;
                        height: 20px;
                        Text {
                            text: "← Изменить";
                            color: Theme.accent;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => {
                                root.auth_step = 0;
                                root.error_message = "";
                            }
                        }
                    }
                }

                if root.is_otp_mode : VerticalLayout {
                    spacing: 6px;
                    Text { text: "6-значный код из письма:"; color: Theme.text-secondary; font-size: 12px; }

                    Rectangle {
                        height: 44px;
                        border-radius: 4px;
                        background: Theme.background-elevated;
                        border-width: 1px;
                        border-color: otp_inp.has-focus ? Theme.text-primary : Theme.border-color;

                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px;
                            otp_inp := TextInput {
                                text <=> root.otp_code;
                                color: Theme.text-primary;
                                font-size: 16px;
                                vertical-alignment: center;
                                accepted => {
                                    if root.otp_code != "" {
                                        root.is_loading = true;
                                        root.error_message = "";
                                        root.submit_otp(root.email, root.otp_code);
                                    } else {
                                        root.error_message = "Введите 6-значный код";
                                    }
                                }
                            }
                        }
                    }
                }

                if !root.is_otp_mode : VerticalLayout {
                    spacing: 6px;
                    Text { text: "Пароль:"; color: Theme.text-secondary; font-size: 12px; }

                    Rectangle {
                        height: 44px;
                        border-radius: 4px;
                        background: Theme.background-elevated;
                        border-width: 1px;
                        border-color: pwd_inp.has-focus ? Theme.text-primary : Theme.border-color;

                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px;
                            pwd_inp := TextInput {
                                text <=> root.password;
                                input-type: password;
                                color: Theme.text-primary;
                                font-size: 14px;
                                vertical-alignment: center;
                                accepted => {
                                    if root.password != "" {
                                        root.is_loading = true;
                                        root.error_message = "";
                                        root.submit_password(root.email, root.password);
                                    } else {
                                        root.error_message = "Введите пароль";
                                    }
                                }
                            }
                        }
                    }
                }

                // Switch between password and code mode
                Rectangle {
                    height: 24px;
                    Text {
                        text: root.is_otp_mode ? "Войти с помощью пароля" : "Войти с помощью одноразового кода";
                        color: Theme.text-secondary;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => {
                            root.is_otp_mode = !root.is_otp_mode;
                            root.error_message = "";
                        }
                    }
                }

                // Submit button
                Rectangle {
                    height: 44px;
                    border-radius: 22px;
                    background: submit_touch.has-hover ? Theme.accent-hover : Theme.accent;

                    Text {
                        text: root.is_loading ? "Подключение..." : (root.is_otp_mode ? "Подтвердить" : "Войти");
                        color: #000000;
                        font-size: 14px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    submit_touch := TouchArea {
                        clicked => {
                            if !root.is_loading {
                                if root.is_otp_mode {
                                    if root.otp_code != "" {
                                        root.is_loading = true;
                                        root.error_message = "";
                                        root.submit_otp(root.email, root.otp_code);
                                    } else {
                                        root.error_message = "Введите 6-значный код";
                                    }
                                } else {
                                    if root.password != "" {
                                        root.is_loading = true;
                                        root.error_message = "";
                                        root.submit_password(root.email, root.password);
                                    } else {
                                        root.error_message = "Введите пароль";
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Cancel / Close
            Rectangle {
                height: 28px;
                Text {
                    text: "Отмена";
                    color: Theme.text-secondary;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea { clicked => { root.cancel(); } }
            }
        }
    }
}
