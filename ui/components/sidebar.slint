import { Theme, PlaylistItem } from "../theme.slint";

export component Sidebar inherits Rectangle {
    width: 280px;
    background: Theme.background-secondary;
    border-radius: Theme.radius-medium;
    
    in property <[PlaylistItem]> playlists: [];
    in property <bool> is_authenticated: false;
    in-out property <int> selected_filter: 0; // 0: Все, 1: Плейлисты, 2: Альбомы, 3: Исполнители
    in-out property <bool> is_searching_library: false;
    in-out property <string> library_search_query: "";
    
    callback create_clicked();
    callback filter_selected(int);
    callback playlist_selected(string);
    callback playlist_context_menu(string, length, length);
    callback login_clicked();
    callback library_search_changed(string);

    VerticalLayout {
        padding: 12px;
        spacing: 12px;

        // Header: "Моя медиатека" + "+ Создать"
        HorizontalLayout {
            Text {
                text: "Моя медиатека";
                color: Theme.text-primary;
                font-size: 16px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            if root.is_authenticated : Rectangle {
                width: 90px;
                height: 32px;
                border-radius: 16px;
                background: create_touch.has-hover ? Theme.background-hover : Theme.background-elevated;

                Text {
                    text: "+ Создать";
                    color: Theme.text-primary;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                create_touch := TouchArea {
                    clicked => { root.create_clicked(); }
                }
            }
        }

        // Filter chips: Все, Плейлисты, Альбомы, Артисты
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            
            for filter_name[idx] in ["Все", "Плейлисты", "Альбомы", "Артисты"] : Rectangle {
                height: 28px;
                border-radius: 14px;
                background: root.selected_filter == idx ? Theme.text-primary : (chip_touch.has-hover ? Theme.background-hover : Theme.background-elevated);
                
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    
                    Text {
                        text: filter_name;
                        color: root.selected_filter == idx ? Theme.background : Theme.text-primary;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                chip_touch := TouchArea {
                    clicked => {
                        root.selected_filter = idx;
                        root.filter_selected(idx);
                    }
                }
            }
        }

        // Search & Sort bar
        HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            spacing: 8px;
            alignment: center;

            // Search Icon button (toggles inline search)
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 14px;
                background: lib_search_touch.has-hover ? #2a2a2a : (root.is_searching_library ? #333333 : transparent);

                Text {
                    text: "🔍";
                    font-size: 13px;
                    color: root.is_searching_library ? #ffffff : Theme.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                lib_search_touch := TouchArea {
                    clicked => {
                        root.is_searching_library = !root.is_searching_library;
                        if !root.is_searching_library {
                            root.library_search_query = "";
                            root.library_search_changed("");
                        }
                    }
                }
            }

            if root.is_searching_library : Rectangle {
                horizontal-stretch: 1;
                height: 28px;
                border-radius: 4px;
                background: #242424;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;

                    TextInput {
                        text <=> root.library_search_query;
                        color: #ffffff;
                        font-size: 11px;
                        vertical-alignment: center;
                        edited => { root.library_search_changed(self.text); }
                    }
                }
            }

            if !root.is_searching_library : Rectangle { horizontal-stretch: 1; }

            Text {
                text: "Недавние ☰";
                font-size: 12px;
                color: Theme.text-secondary;
                font-weight: 500;
                vertical-alignment: center;
            }
        }

        // Playlists list inside Flickable
        if root.playlists.length > 0 : Flickable {
            vertical-stretch: 1;
            content-height: root.playlists.length * 60px;
            
            VerticalLayout {
                spacing: 4px;

                for item[idx] in root.playlists : Rectangle {
                    height: 56px;
                    border-radius: Theme.radius-small;
                    background: item.is_active ? Theme.background-elevated : (item_touch.has-hover ? Theme.background-hover : transparent);

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 12px;

                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 44px;
                            height: 44px;
                            border-radius: item.item_type == 2 ? 22px : 4px;
                            background: item.item_type == 3 ? #4c1d95 : (item.item_type == 4 ? #312e81 : (item.item_type == 1 ? #1e293b : (item.is_pinned ? #331f54 : #282828)));

                            Text {
                                text: item.item_type == 3 ? "♥" : (item.item_type == 2 ? "👤" : (item.item_type == 1 ? "💽" : (item.item_type == 4 ? "📻" : "♪")));
                                color: item.item_type == 3 ? #f472b6 : (item.is_pinned ? #a855f7 : Theme.text-secondary);
                                font-size: 18px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;

                            Text {
                                text: item.title;
                                color: item.is_active ? Theme.accent : Theme.text-primary;
                                font-size: 14px;
                                font-weight: 600;
                                overflow: elide;
                            }

                            Text {
                                text: item.subtitle;
                                color: Theme.text-secondary;
                                font-size: 12px;
                                overflow: elide;
                            }
                        }

                        if item.is_pinned : Text {
                            text: "📌";
                            font-size: 12px;
                            color: Theme.accent;
                            vertical-alignment: center;
                        }
                    }

                    item_touch := TouchArea {
                        clicked => { root.playlist_selected(item.id); }
                        pointer-event(event) => {
                            if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                                root.playlist_context_menu(item.id, 260px, Math.min(Math.max(60px, idx * 60px + 100px), 600px));
                            }
                        }
                    }
                }
            }
        }

        // Empty state when unauthenticated or empty library
        if root.playlists.length == 0 : VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 12px;

            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 64px;
                    height: 64px;
                    border-radius: 32px;
                    background: Theme.background-elevated;

                    Text {
                        text: "♪";
                        font-size: 28px;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Text {
                text: root.is_authenticated ? "В медиатеке пока пусто" : "Войдите в аккаунт";
                color: Theme.text-primary;
                font-size: 14px;
                font-weight: 700;
                horizontal-alignment: center;
            }

            Text {
                text: root.is_authenticated ? "Создайте плейлист или сохраните треки" : "чтобы увидеть плейлисты и треки";
                color: Theme.text-secondary;
                font-size: 12px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            if !root.is_authenticated : HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 140px;
                    height: 36px;
                    border-radius: 18px;
                    background: Theme.accent;

                    Text {
                        text: "Войти";
                        color: #000000;
                        font-size: 13px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea { clicked => { root.login_clicked(); } }
                }
            }
        }
    }
}
