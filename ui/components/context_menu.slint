import { Theme, PlaylistItem } from "../theme.slint";

export component ContextMenu inherits Rectangle {
    background: transparent;

    in property <int> menu_type: 0; // 0: Playlist, 1: Track, 2: Album, 3: Artist
    in property <string> target_id: "";
    in property <string> target_title: "";
    in property <bool> is_liked: false;
    in property <length> menu_x: 200px;
    in property <length> menu_y: 150px;
    in property <[PlaylistItem]> playlists: [];
    in-out property <bool> is_submenu_open: false;
    in-out property <string> submenu_search: "";

    callback close();
    callback add_to_queue(string);
    callback like_toggle(string);
    callback copy_link(string, int);
    callback delete_playlist(string);
    callback create_playlist();
    callback go_to_artist(string);
    callback go_to_album(string);
    callback add_track_to_playlist(string, string);

    // Full-screen transparent backdrop: clicking outside closes the menu
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.close(); }
    }

    // Floating Popup Box
    menu_box := Rectangle {
        width: 320px;
        height: root.menu_type == 0 ? 530px : (root.menu_type == 1 ? 438px : (root.menu_type == 2 ? 220px : 180px));
        
        // Exact position clamping: never overflows right or bottom (stays above player bar)
        x: Math.min(Math.max(12px, root.menu_x), parent.width - self.width - 16px);
        y: (root.menu_y + self.height > parent.height - 76px)
            ? Math.max(64px, parent.height - self.height - 76px)
            : Math.max(64px, root.menu_y);

        background: #282828;
        border-radius: 4px;
        border-width: 1px;
        border-color: #383838;
        drop-shadow-blur: 16px;
        drop-shadow-color: #000000cc;

        VerticalLayout {
            padding: 4px;
            spacing: 0px;
            alignment: start;

            // ========================================================
            // 0: PLAYLIST CONTEXT MENU (100% matching playlist menu.png)
            // ========================================================
            if root.menu_type == 0 : VerticalLayout {
                spacing: 0px;

                // 1. Добавить в очередь
                Rectangle {
                    height: 36px; border-radius: 4px;
                    background: it_p1.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px; spacing: 12px;
                        Text { width: 22px; text: "+Ξ"; color: #b3b3b3; font-size: 14px; vertical-alignment: center; }
                        Text { text: "Добавить в очередь"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; }
                    }
                    it_p1 := TouchArea {
                        clicked => {
                            root.add_to_queue(root.target_id);
                            root.close();
                        }
                    }
                }

                // 2. Начать джем
                Rectangle {
                    height: 36px; border-radius: 4px;
                    background: it_p2.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px; spacing: 12px;
                        Text { width: 22px; text: "🎧"; color: #b3b3b3; font-size: 13px; vertical-alignment: center; }
                        Text { text: "Начать джем"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; }
                    }
                    it_p2 := TouchArea { clicked => { root.close(); } }
                }

                // 3. Добавить в профиль
                Rectangle {
                    height: 36px; border-radius: 4px;
                    background: it_p3.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px; spacing: 12px;
                        Text { width: 22px; text: "👤"; color: #b3b3b3; font-size: 13px; vertical-alignment: center; }
                        Text { text: "Добавить в профиль"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; }
                    }
                    it_p3 := TouchArea { clicked => { root.close(); } }
                }

                // 4. Изменение сведений
                Rectangle {
                    height: 36px; border-radius: 4px;
                    background: it_p4.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px; spacing: 12px;
                        Text { width: 22px; text: "✏️"; color: #b3b3b3; font-size: 13px; vertical-alignment: center; }
                        Text { text: "Изменение сведений"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; }
                    }
                    it_p4 := TouchArea { clicked => { root.close(); } }
                }

                // 5. Удалить
                Rectangle {
                    height: 36px; border-radius: 4px;
                    background: it_p5.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px; spacing: 12px;
                        Text { width: 22px; text: "⊖"; color: #b3b3b3; font-size: 14px; vertical-alignment: center; }
                        Text { text: "Удалить"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; }
                    }
                    it_p5 := TouchArea {
                        clicked => {
                            root.delete_playlist(root.target_id);
                            root.close();
                        }
                    }
                }

                // 6. Скачать
                Rectangle {
                    height: 36px; border-radius: 4px;
                    background: it_p6.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px; spacing: 12px;
                        Text { width: 22px; text: "↓"; color: #b3b3b3; font-size: 14px; vertical-alignment: center; }
                        Text { text: "Скачать"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; }
                    }
                    it_p6 := TouchArea { clicked => { root.close(); } }
                }

                // Separator 1
                VerticalLayout {
                    padding-top: 4px; padding-bottom: 4px;
                    Rectangle { height: 1px; background: #383838; }
                }

                // 7. Создать плейлист
                Rectangle {
                    height: 36px; border-radius: 4px;
                    background: it_p7.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px; spacing: 12px;
                        Text { width: 22px; text: "♪+"; color: #b3b3b3; font-size: 14px; vertical-alignment: center; }
                        Text { text: "Создать плейлист"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; }
                    }
                    it_p7 := TouchArea {
                        clicked => {
                            root.create_playlist();
                            root.close();
                        }
                    }
                }

                // 8. Создать папку
                Rectangle {
                    height: 36px; border-radius: 4px;
                    background: it_p8.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px; spacing: 12px;
                        Text { width: 22px; text: "📁+"; color: #b3b3b3; font-size: 13px; vertical-alignment: center; }
                        Text { text: "Создать папку"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; }
                    }
                    it_p8 := TouchArea { clicked => { root.close(); } }
                }

                // Separator 2
                VerticalLayout {
                    padding-top: 4px; padding-bottom: 4px;
                    Rectangle { height: 1px; background: #383838; }
                }

                // 9. Закрыть доступ
                Rectangle {
                    height: 36px; border-radius: 4px;
                    background: it_p9.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px; spacing: 12px;
                        Text { width: 22px; text: "🔒"; color: #b3b3b3; font-size: 13px; vertical-alignment: center; }
                        Text { text: "Закрыть доступ"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; }
                    }
                    it_p9 := TouchArea { clicked => { root.close(); } }
                }

                // 10. Пригласить соавторов
                Rectangle {
                    height: 36px; border-radius: 4px;
                    background: it_p10.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px; spacing: 12px;
                        Text { width: 22px; text: "👥"; color: #b3b3b3; font-size: 13px; vertical-alignment: center; }
                        Text { text: "Пригласить соавторов"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; }
                    }
                    it_p10 := TouchArea { clicked => { root.close(); } }
                }

                // 11. Исключить из музыкальных предпочтений
                Rectangle {
                    height: 36px; border-radius: 4px;
                    background: it_p11.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px; spacing: 12px;
                        Text { width: 22px; text: "⊗"; color: #b3b3b3; font-size: 14px; vertical-alignment: center; }
                        Text { text: "Исключить из предпочтений"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; }
                    }
                    it_p11 := TouchArea { clicked => { root.close(); } }
                }

                // Separator 3
                VerticalLayout {
                    padding-top: 4px; padding-bottom: 4px;
                    Rectangle { height: 1px; background: #383838; }
                }

                // 12. Закрепить плейлист
                Rectangle {
                    height: 36px; border-radius: 4px;
                    background: it_p12.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px; spacing: 12px;
                        Text { width: 22px; text: "📌"; color: #b3b3b3; font-size: 13px; vertical-alignment: center; }
                        Text { text: "Закрепить плейлист"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; }
                    }
                    it_p12 := TouchArea { clicked => { root.close(); } }
                }

                // 13. Поделиться ▸
                Rectangle {
                    height: 36px; border-radius: 4px;
                    background: it_p13.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px; spacing: 12px;
                        Text { width: 22px; text: "↑"; color: #b3b3b3; font-size: 14px; vertical-alignment: center; }
                        Text { text: "Поделиться"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; horizontal-stretch: 1; }
                        Text { text: "▸"; color: #b3b3b3; font-size: 13px; vertical-alignment: center; }
                    }
                    it_p13 := TouchArea {
                        clicked => {
                            root.copy_link(root.target_id, 0);
                            root.close();
                        }
                    }
                }
            }

            // ========================================================
            // 1: TRACK CONTEXT MENU (100% matching track_menu.png)
            // ========================================================
            if root.menu_type == 1 : VerticalLayout {
                spacing: 0px;

                // 1. Добавить в плейлист ▸
                Rectangle {
                    height: 38px; border-radius: 4px;
                    background: (it_t1.has-hover || root.is_submenu_open) ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: 14px;
                        Text { width: 20px; text: "+"; color: #b3b3b3; font-size: 17px; vertical-alignment: center; }
                        Text { text: "Добавить в плейлист"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; horizontal-stretch: 1; }
                        Text { text: "▸"; color: #b3b3b3; font-size: 13px; vertical-alignment: center; }
                    }
                    it_t1 := TouchArea {
                        pointer-event(event) => {
                            root.is_submenu_open = true;
                        }
                        clicked => {
                            root.is_submenu_open = true;
                        }
                    }
                }

                // 2. Удалить из любимых треков / Сохранить в «Любимые треки»
                Rectangle {
                    height: 38px; border-radius: 4px;
                    background: it_t2.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: 14px;
                        Text {
                            width: 20px;
                            text: root.is_liked ? "✔" : "♡";
                            color: root.is_liked ? #1ed760 : #b3b3b3;
                            font-size: 16px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.is_liked ? "Удалить из любимых треков" : "Сохранить в «Любимые треки»";
                            color: #ffffff;
                            font-size: 13px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                    }
                    it_t2 := TouchArea {
                        clicked => {
                            root.like_toggle(root.target_id);
                            root.close();
                        }
                    }
                }

                // 3. Добавить в очередь
                Rectangle {
                    height: 38px; border-radius: 4px;
                    background: it_t3.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: 14px;
                        Text { width: 20px; text: "+Ξ"; color: #b3b3b3; font-size: 14px; vertical-alignment: center; }
                        Text { text: "Добавить в очередь"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; }
                    }
                    it_t3 := TouchArea {
                        clicked => {
                            root.add_to_queue(root.target_id);
                            root.close();
                        }
                    }
                }

                // 4. Исключить из музыкальных предпочтений
                Rectangle {
                    height: 38px; border-radius: 4px;
                    background: it_t4.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: 14px;
                        Text { width: 20px; text: "⊗"; color: #b3b3b3; font-size: 15px; vertical-alignment: center; }
                        Text { text: "Исключить из предпочтений"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; }
                    }
                    it_t4 := TouchArea { clicked => { root.close(); } }
                }

                // 5. Начать джем
                Rectangle {
                    height: 38px; border-radius: 4px;
                    background: it_t5.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: 14px;
                        Text { width: 20px; text: "🎧"; color: #b3b3b3; font-size: 14px; vertical-alignment: center; }
                        Text { text: "Начать джем"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; }
                    }
                    it_t5 := TouchArea { clicked => { root.close(); } }
                }

                // 6. Таймер сна ▸
                Rectangle {
                    height: 38px; border-radius: 4px;
                    background: it_t6.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: 14px;
                        Text { width: 20px; text: "⏱"; color: #b3b3b3; font-size: 14px; vertical-alignment: center; }
                        Text { text: "Таймер сна"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; horizontal-stretch: 1; }
                        Text { text: "▸"; color: #b3b3b3; font-size: 13px; vertical-alignment: center; }
                    }
                    it_t6 := TouchArea { clicked => { root.close(); } }
                }

                // Separator 1
                VerticalLayout {
                    padding-top: 4px; padding-bottom: 4px;
                    Rectangle { height: 1px; background: #383838; }
                }

                // 7. К радио по треку
                Rectangle {
                    height: 38px; border-radius: 4px;
                    background: it_t7.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: 14px;
                        Text { width: 20px; text: "📻"; color: #b3b3b3; font-size: 14px; vertical-alignment: center; }
                        Text { text: "К радио по треку"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; }
                    }
                    it_t7 := TouchArea { clicked => { root.close(); } }
                }

                // 8. К исполнителю ▸
                Rectangle {
                    height: 38px; border-radius: 4px;
                    background: it_t8.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: 14px;
                        Text { width: 20px; text: "👤"; color: #b3b3b3; font-size: 14px; vertical-alignment: center; }
                        Text { text: "К исполнителю"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; horizontal-stretch: 1; }
                        Text { text: "▸"; color: #b3b3b3; font-size: 13px; vertical-alignment: center; }
                    }
                    it_t8 := TouchArea {
                        clicked => {
                            root.go_to_artist(root.target_id);
                            root.close();
                        }
                    }
                }

                // 9. К альбому
                Rectangle {
                    height: 38px; border-radius: 4px;
                    background: it_t9.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: 14px;
                        Text { width: 20px; text: "◎"; color: #b3b3b3; font-size: 14px; vertical-alignment: center; }
                        Text { text: "К альбому"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; }
                    }
                    it_t9 := TouchArea {
                        clicked => {
                            root.go_to_album(root.target_id);
                            root.close();
                        }
                    }
                }

                // 10. Посмотреть сведения
                Rectangle {
                    height: 38px; border-radius: 4px;
                    background: it_t10.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: 14px;
                        Text { width: 20px; text: "♪="; color: #b3b3b3; font-size: 14px; vertical-alignment: center; }
                        Text { text: "Посмотреть сведения"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; }
                    }
                    it_t10 := TouchArea { clicked => { root.close(); } }
                }

                // Separator 2
                VerticalLayout {
                    padding-top: 4px; padding-bottom: 4px;
                    Rectangle { height: 1px; background: #383838; }
                }

                // 11. Поделиться ▸
                Rectangle {
                    height: 38px; border-radius: 4px;
                    background: it_t11.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: 14px;
                        Text { width: 20px; text: "↑"; color: #b3b3b3; font-size: 14px; vertical-alignment: center; }
                        Text { text: "Поделиться"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; horizontal-stretch: 1; }
                        Text { text: "▸"; color: #b3b3b3; font-size: 13px; vertical-alignment: center; }
                    }
                    it_t11 := TouchArea {
                        clicked => {
                            root.copy_link(root.target_id, 1);
                            root.close();
                        }
                    }
                }
            }

            // ========================================================
            // 2: ALBUM CONTEXT MENU (100% matching album_menu.png)
            // ========================================================
            if root.menu_type == 2 : VerticalLayout {
                spacing: 0px;

                // 1. Добавить в медиатеку
                Rectangle {
                    height: 38px; border-radius: 4px;
                    background: it_a1.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: 14px;
                        Text { width: 20px; text: "⊕"; color: #b3b3b3; font-size: 16px; vertical-alignment: center; }
                        Text { text: "Добавить в медиатеку"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; }
                    }
                    it_a1 := TouchArea { clicked => { root.close(); } }
                }

                // 2. Добавить в очередь
                Rectangle {
                    height: 38px; border-radius: 4px;
                    background: it_a2.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: 14px;
                        Text { width: 20px; text: "+Ξ"; color: #b3b3b3; font-size: 14px; vertical-alignment: center; }
                        Text { text: "Добавить в очередь"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; }
                    }
                    it_a2 := TouchArea {
                        clicked => {
                            root.add_to_queue(root.target_id);
                            root.close();
                        }
                    }
                }

                // 3. К радио по исполнителю
                Rectangle {
                    height: 38px; border-radius: 4px;
                    background: it_a3.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: 14px;
                        Text { width: 20px; text: "📻"; color: #b3b3b3; font-size: 14px; vertical-alignment: center; }
                        Text { text: "К радио по исполнителю"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; }
                    }
                    it_a3 := TouchArea { clicked => { root.close(); } }
                }

                // Separator 1
                VerticalLayout {
                    padding-top: 4px; padding-bottom: 4px;
                    Rectangle { height: 1px; background: #383838; }
                }

                // 4. Добавить в плейлист ▸
                Rectangle {
                    height: 38px; border-radius: 4px;
                    background: it_a4.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: 14px;
                        Text { width: 20px; text: "+"; color: #b3b3b3; font-size: 17px; vertical-alignment: center; }
                        Text { text: "Добавить в плейлист"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; horizontal-stretch: 1; }
                        Text { text: "▸"; color: #b3b3b3; font-size: 13px; vertical-alignment: center; }
                    }
                    it_a4 := TouchArea { clicked => { root.close(); } }
                }

                // 5. Скачать
                Rectangle {
                    height: 38px; border-radius: 4px;
                    background: it_a5.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: 14px;
                        Text { width: 20px; text: "↓"; color: #b3b3b3; font-size: 14px; vertical-alignment: center; }
                        Text { text: "Скачать"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; }
                    }
                    it_a5 := TouchArea { clicked => { root.close(); } }
                }

                // 6. Поделиться ▸
                Rectangle {
                    height: 38px; border-radius: 4px;
                    background: it_a6.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: 14px;
                        Text { width: 20px; text: "↑"; color: #b3b3b3; font-size: 14px; vertical-alignment: center; }
                        Text { text: "Поделиться"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; horizontal-stretch: 1; }
                        Text { text: "▸"; color: #b3b3b3; font-size: 13px; vertical-alignment: center; }
                    }
                    it_a6 := TouchArea {
                        clicked => {
                            root.copy_link(root.target_id, 2);
                            root.close();
                        }
                    }
                }
            }

            // ========================================================
            // 3: ARTIST CONTEXT MENU (100% matching artist_menu.png)
            // ========================================================
            if root.menu_type == 3 : VerticalLayout {
                spacing: 0px;

                // 1. Подписаться
                Rectangle {
                    height: 38px; border-radius: 4px;
                    background: it_ar1.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: 14px;
                        Text { width: 20px; text: "👤"; color: #b3b3b3; font-size: 14px; vertical-alignment: center; }
                        Text { text: "Подписаться"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; }
                    }
                    it_ar1 := TouchArea { clicked => { root.close(); } }
                }

                // 2. Не включать треки этого исполнителя
                Rectangle {
                    height: 38px; border-radius: 4px;
                    background: it_ar2.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: 14px;
                        Text { width: 20px; text: "⊘"; color: #b3b3b3; font-size: 15px; vertical-alignment: center; }
                        Text { text: "Не включать треки"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; }
                    }
                    it_ar2 := TouchArea { clicked => { root.close(); } }
                }

                // 3. К радио по исполнителю
                Rectangle {
                    height: 38px; border-radius: 4px;
                    background: it_ar3.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: 14px;
                        Text { width: 20px; text: "📻"; color: #b3b3b3; font-size: 14px; vertical-alignment: center; }
                        Text { text: "К радио по исполнителю"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; }
                    }
                    it_ar3 := TouchArea { clicked => { root.close(); } }
                }

                // 4. Пожаловаться
                Rectangle {
                    height: 38px; border-radius: 4px;
                    background: it_ar4.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: 14px;
                        Text { width: 20px; text: "!"; color: #b3b3b3; font-size: 15px; vertical-alignment: center; }
                        Text { text: "Пожаловаться"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; }
                    }
                    it_ar4 := TouchArea { clicked => { root.close(); } }
                }

                // Separator 1
                VerticalLayout {
                    padding-top: 4px; padding-bottom: 4px;
                    Rectangle { height: 1px; background: #383838; }
                }

                // 5. Поделиться ▸
                Rectangle {
                    height: 38px; border-radius: 4px;
                    background: it_ar5.has-hover ? #3e3e3e : transparent;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: 14px;
                        Text { width: 20px; text: "↑"; color: #b3b3b3; font-size: 14px; vertical-alignment: center; }
                        Text { text: "Поделиться"; color: #ffffff; font-size: 13px; font-weight: 500; vertical-alignment: center; horizontal-stretch: 1; }
                        Text { text: "▸"; color: #b3b3b3; font-size: 13px; vertical-alignment: center; }
                    }
                    it_ar5 := TouchArea {
                        clicked => {
                            root.copy_link(root.target_id, 3);
                            root.close();
                        }
                    }
                }
            }
        }
    }

    // Cascading Submenu Box ("Добавить в плейлист ▸" matching official Spotify UI)
    if root.is_submenu_open : submenu_box := Rectangle {
        width: 274px;
        height: 380px;
        x: (menu_box.x + menu_box.width + self.width > parent.width - 16px)
            ? Math.max(12px, menu_box.x - self.width - 4px)
            : (menu_box.x + menu_box.width + 4px);
        y: Math.min(menu_box.y, parent.height - self.height - 76px);
        background: #282828;
        border-radius: 4px;
        border-width: 1px;
        border-color: #383838;
        drop-shadow-blur: 16px;
        drop-shadow-color: #000000cc;

        VerticalLayout {
            padding: 6px;
            spacing: 4px;

            // Search input inside submenu: "Поиск плейлиста"
            Rectangle {
                height: 32px;
                border-radius: 4px;
                background: #1f1f1f;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;
                    Text { text: "🔍"; font-size: 11px; color: #b3b3b3; vertical-alignment: center; }
                    TextInput {
                        text <=> root.submenu_search;
                        color: #ffffff;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }

            // Action: "+ Создать плейлист"
            Rectangle {
                height: 34px;
                border-radius: 4px;
                background: sub_create.has-hover ? #3e3e3e : transparent;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    Text { text: "+"; font-size: 15px; color: #ffffff; vertical-alignment: center; }
                    Text { text: "Создать плейлист"; font-size: 13px; font-weight: 500; color: #ffffff; vertical-alignment: center; }
                }
                sub_create := TouchArea {
                    clicked => {
                        root.create_playlist();
                        root.close();
                    }
                }
            }

            // Divider
            Rectangle { height: 1px; background: #383838; }

            // Playlists list inside Flickable
            Flickable {
                vertical-stretch: 1;
                content-height: root.playlists.length * 36px;

                VerticalLayout {
                    spacing: 2px;
                    for pl in root.playlists : Rectangle {
                        height: 34px;
                        border-radius: 4px;
                        background: sub_pl_touch.has-hover ? #3e3e3e : transparent;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;
                            alignment: center;
                            Text {
                                text: "♪";
                                font-size: 13px;
                                color: #b3b3b3;
                                vertical-alignment: center;
                            }
                            Text {
                                text: pl.title;
                                font-size: 13px;
                                font-weight: 500;
                                color: #ffffff;
                                overflow: elide;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                        }

                        sub_pl_touch := TouchArea {
                            clicked => {
                                root.add_track_to_playlist(root.target_id, pl.id);
                                root.close();
                            }
                        }
                    }
                }
            }
        }
    }
}
