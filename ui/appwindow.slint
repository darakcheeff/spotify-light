import { Theme, TrackItem, PlaylistItem, DeviceItem, LyricLine } from "theme.slint";
import { TopBar } from "components/top_bar.slint";
import { Sidebar } from "components/sidebar.slint";
import { PlayerBar } from "components/player_bar.slint";
import { RightDrawer } from "components/right_drawer.slint";
import { HomeView } from "components/home_view.slint";
import { AlbumView } from "components/album_view.slint";
import { LyricsView } from "components/lyrics_view.slint";
import { LoginDialog } from "components/login_dialog.slint";

export component AppWindow inherits Window {
    title: "SpotifyLight";
    min-width: 960px;
    min-height: 640px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.background;
    default-font-family: Theme.font-family;

    in-out property <int> current_workspace: 0; // 0: Home, 1: Album/Playlist
    in-out property <bool> is_lyrics_open: false;
    in-out property <bool> is_drawer_open: false;
    in-out property <int> drawer_mode: 0; // 0: Queue, 1: Connect Devices
    in-out property <bool> is_login_open: false;

    // Track playback state (synchronized with Audio Engine via event loop)
    in-out property <string> active_track_title: "JOHN CENA";
    in-out property <string> active_track_artist: "Joey Valence & Brae";
    in-out property <string> current_time: "1:25";
    in-out property <string> total_time: "2:43";
    in-out property <float> track_progress: 0.52;
    in-out property <bool> is_playing: true;
    in-out property <bool> is_liked: true;
    in-out property <float> current_volume: 0.8;

    // Navigation history for Back / Forward
    in-out property <int> history_index: 0;

    // Callbacks to Rust backend
    callback play_pause();
    callback next_track();
    callback prev_track();
    callback seek_position(float);
    callback change_volume(float);
    callback select_connect_device(string);
    callback search_query(string);
    callback login_requested(string, string);
    callback otp_submitted(string, string);

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // 1. Top Navigation Bar
        TopBar {
            nav_back => {
                if root.current_workspace > 0 {
                    root.current_workspace = 0;
                }
            }
            nav_home => {
                root.current_workspace = 0;
                root.is_lyrics_open = false;
            }
            search_changed(query) => {
                root.search_query(query);
            }
            profile_clicked => {
                root.is_login_open = !root.is_login_open;
            }
        }

        // 2. Middle Area (Sidebar + Persistent Workspaces + Right Drawer)
        HorizontalLayout {
            vertical-stretch: 1;
            padding-left: 8px;
            padding-right: 8px;
            spacing: 8px;

            // Left Sidebar
            Sidebar {
                playlist_selected(id) => {
                    root.current_workspace = 1;
                    root.is_lyrics_open = false;
                }
            }

            // Central Workspace Stack
            // Using visible property instead of 'if' prevents destruction of views,
            // preserving scroll offsets, user inputs, and avoiding reallocation churn!
            Rectangle {
                horizontal-stretch: 1;
                border-radius: Theme.radius-medium;
                clip: true;

                // View 1: Karaoke / Lyrics (on top when active)
                LyricsView {
                    visible: root.is_lyrics_open;
                    close_lyrics => { root.is_lyrics_open = false; }
                }

                // View 2: Home Catalog (state preserved on navigation)
                HomeView {
                    visible: !root.is_lyrics_open && root.current_workspace == 0;
                    open_album(title) => { root.current_workspace = 1; }
                }

                // View 3: Album / Playlist View
                AlbumView {
                    visible: !root.is_lyrics_open && root.current_workspace == 1;
                }
            }

            // Right Drawer (Queue / Recently Played / Connect Devices)
            if root.is_drawer_open : RightDrawer {
                mode: root.drawer_mode;
                close_drawer => { root.is_drawer_open = false; }
                select_device(id) => { root.select_connect_device(id); }
            }
        }

        // 3. Bottom Player Bar (Single source of truth)
        PlayerBar {
            track_title: root.active_track_title;
            track_artist: root.active_track_artist;
            current_time_str: root.current_time;
            total_time_str: root.total_time;
            progress: root.track_progress;
            is_playing: root.is_playing;
            is_liked: root.is_liked;
            volume: root.current_volume;
            
            lyrics_open: root.is_lyrics_open;
            queue_open: root.is_drawer_open && root.drawer_mode == 0;
            devices_open: root.is_drawer_open && root.drawer_mode == 1;

            play_pause_clicked => {
                root.is_playing = !root.is_playing;
                root.play_pause();
            }
            next_clicked => { root.next_track(); }
            prev_clicked => { root.prev_track(); }
            seek(val) => {
                root.track_progress = val;
                root.seek_position(val);
            }
            volume_changed(val) => {
                root.current_volume = val;
                root.change_volume(val);
            }
            toggle_lyrics => {
                root.is_lyrics_open = !root.is_lyrics_open;
            }
            toggle_queue => {
                if root.is_drawer_open && root.drawer_mode == 0 {
                    root.is_drawer_open = false;
                } else {
                    root.is_drawer_open = true;
                    root.drawer_mode = 0;
                }
            }
            toggle_devices => {
                if root.is_drawer_open && root.drawer_mode == 1 {
                    root.is_drawer_open = false;
                } else {
                    root.is_drawer_open = true;
                    root.drawer_mode = 1;
                }
            }
        }
    }

    // Modal Login Dialog Overlay
    if root.is_login_open : LoginDialog {
        cancel => { root.is_login_open = false; }
        submit_password(email, pwd) => { root.login_requested(email, pwd); }
        submit_otp(email, code) => { root.otp_submitted(email, code); }
    }
}
