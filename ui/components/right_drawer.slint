import { Theme, TrackItem, DeviceItem } from "../theme.slint";

export component RightDrawer inherits Rectangle {
    width: 320px;
    background: Theme.background-secondary;
    border-radius: Theme.radius-medium;
    
    in property <int> mode: 0; // 0: Queue, 1: Connect Devices, 2: Track Details
    in-out property <int> queue_tab: 0; // 0: Очередь, 1: Недавно прослушано
    
    in property <TrackItem> current_track: {
        id: "", index: 0, title: "", artist: "",
        album: "", duration_str: "", play_count_str: "", is_liked: false, is_playing: false
    };
    
    in property <[TrackItem]> queue_items: [];
    in property <[TrackItem]> recent_items: [];
    in property <[DeviceItem]> devices: [];

    callback close_drawer();
    callback select_device(string);
    callback play_queue_item(string);
    callback start_jam();

    VerticalLayout {
        padding: 16px;
        spacing: 16px;

        // MODE 0: QUEUE & RECENTLY PLAYED
        if root.mode == 0 : VerticalLayout {
            spacing: 14px;

            // Header with Tabs & Close button
            HorizontalLayout {
                alignment: center;
                spacing: 12px;

                // Tab: Очередь
                Rectangle {
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        Text {
                            text: "Очередь";
                            color: root.queue_tab == 0 ? Theme.text-primary : Theme.text-secondary;
                            font-size: 14px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            height: 2px;
                            background: root.queue_tab == 0 ? Theme.accent : transparent;
                        }
                    }
                    TouchArea { clicked => { root.queue_tab = 0; } }
                }

                // Tab: Недавно прослушано
                Rectangle {
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        Text {
                            text: "Недавно прослушано";
                            color: root.queue_tab == 1 ? Theme.text-primary : Theme.text-secondary;
                            font-size: 14px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            height: 2px;
                            background: root.queue_tab == 1 ? Theme.accent : transparent;
                        }
                    }
                    TouchArea { clicked => { root.queue_tab = 1; } }
                }

                Rectangle { horizontal-stretch: 1; }

                // Close Button ✕
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    background: close_q.has-hover ? Theme.background-hover : transparent;
                    
                    Text {
                        text: "✕";
                        color: Theme.text-secondary;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    close_q := TouchArea { clicked => { root.close_drawer(); } }
                }
            }

            // Tab 0: Queue
            if root.queue_tab == 0 : VerticalLayout {
                spacing: 10px;

                if root.current_track.title != "" : VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "Сейчас играет";
                        color: Theme.text-secondary;
                        font-size: 12px;
                        font-weight: 700;
                    }

                    Rectangle {
                        height: 60px;
                        border-radius: 6px;
                        background: Theme.background-elevated;

                        HorizontalLayout {
                            padding: 8px;
                            spacing: 12px;
                            alignment: center;

                            Rectangle {
                                width: 44px;
                                height: 44px;
                                border-radius: 4px;
                                background: #333333;
                                Text {
                                    text: "▶";
                                    color: Theme.accent;
                                    font-size: 16px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: root.current_track.title;
                                    color: Theme.accent;
                                    font-size: 14px;
                                    font-weight: 700;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.current_track.artist;
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }

                // Next up in Queue
                Text {
                    text: "Далее в очереди";
                    color: Theme.text-secondary;
                    font-size: 12px;
                    font-weight: 700;
                }

                if root.queue_items.length == 0 : VerticalLayout {
                    padding-top: 32px;
                    spacing: 8px;
                    alignment: center;

                    Text {
                        text: "В очереди пока пусто";
                        color: Theme.text-primary;
                        font-size: 14px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Добавьте треки в очередь или включите плейлист";
                        color: Theme.text-secondary;
                        font-size: 12px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                if root.queue_items.length > 0 : Flickable {
                    vertical-stretch: 1;
                    content-height: 400px;

                    VerticalLayout {
                        spacing: 4px;

                        for item in root.queue_items : Rectangle {
                            height: 48px;
                            border-radius: 4px;
                            background: q_item_touch.has-hover ? Theme.background-hover : transparent;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 12px;
                                alignment: center;

                                Text {
                                    width: 16px;
                                    text: item.index;
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 2px;

                                    Text {
                                        text: item.title;
                                        color: Theme.text-primary;
                                        font-size: 13px;
                                        font-weight: 600;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: item.artist;
                                        color: Theme.text-secondary;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                }

                                Text {
                                    text: item.duration_str;
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                }
                            }

                            q_item_touch := TouchArea {
                                clicked => { root.play_queue_item(item.id); }
                            }
                        }
                    }
                }
            }

            // Tab 1: Recently Played
            if root.queue_tab == 1 : VerticalLayout {
                spacing: 10px;

                if root.recent_items.length == 0 : VerticalLayout {
                    padding-top: 32px;
                    spacing: 8px;
                    alignment: center;

                    Text {
                        text: "История прослушивания пуста";
                        color: Theme.text-primary;
                        font-size: 14px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Здесь появятся недавно воспроизведенные треки";
                        color: Theme.text-secondary;
                        font-size: 12px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                if root.recent_items.length > 0 : Flickable {
                    vertical-stretch: 1;
                    content-height: 400px;

                    VerticalLayout {
                        spacing: 4px;

                        for item in root.recent_items : Rectangle {
                            height: 48px;
                            border-radius: 4px;
                            background: r_item_touch.has-hover ? Theme.background-hover : transparent;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 12px;
                                alignment: center;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 2px;

                                    Text {
                                        text: item.title;
                                        color: Theme.text-primary;
                                        font-size: 13px;
                                        font-weight: 600;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: item.artist;
                                        color: Theme.text-secondary;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                }
                            }

                            r_item_touch := TouchArea {
                                clicked => { root.play_queue_item(item.id); }
                            }
                        }
                    }
                }
            }
        }

        // MODE 1: CONNECT TO A DEVICE (Google Home, Speakers, etc.)
        if root.mode == 1 : VerticalLayout {
            spacing: 16px;

            // Header
            HorizontalLayout {
                alignment: center;
                Text {
                    text: "Connect";
                    color: Theme.text-primary;
                    font-size: 18px;
                    font-weight: 700;
                    horizontal-stretch: 1;
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    background: close_c.has-hover ? Theme.background-hover : transparent;

                    Text {
                        text: "✕";
                        color: Theme.text-secondary;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    close_c := TouchArea { clicked => { root.close_drawer(); } }
                }
            }

            // Current Device
            Text {
                text: "Текущее устройство";
                color: Theme.text-secondary;
                font-size: 12px;
                font-weight: 700;
            }

            Rectangle {
                height: 56px;
                border-radius: 6px;
                background: Theme.background-elevated;

                HorizontalLayout {
                    padding: 12px;
                    spacing: 12px;
                    alignment: center;

                    Text {
                        text: "💻";
                        font-size: 20px;
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "Этот компьютер";
                            color: Theme.accent;
                            font-size: 14px;
                            font-weight: 700;
                        }
                        Text {
                            text: "SpotifyLight (PipeWire / ALSA)";
                            color: Theme.text-secondary;
                            font-size: 11px;
                        }
                    }

                    Text {
                        text: "🔊";
                        color: Theme.accent;
                        font-size: 16px;
                    }
                }
            }

            // Select another device
            Text {
                text: "Выберите устройство в сети";
                color: Theme.text-secondary;
                font-size: 12px;
                font-weight: 700;
            }

            if root.devices.length == 0 : VerticalLayout {
                padding-top: 24px;
                spacing: 8px;
                alignment: center;

                Text {
                    text: "Поиск устройств...";
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Колонки Spotify Connect и Google Cast в вашей локальной сети появятся здесь автоматически";
                    color: Theme.text-secondary;
                    font-size: 11px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            if root.devices.length > 0 : Flickable {
                vertical-stretch: 1;
                content-height: 300px;

                VerticalLayout {
                    spacing: 6px;

                    for dev in root.devices : Rectangle {
                        height: 52px;
                        border-radius: 6px;
                        background: dev_touch.has-hover ? Theme.background-hover : transparent;

                        HorizontalLayout {
                            padding: 12px;
                            spacing: 12px;
                            alignment: center;

                            Text {
                                text: dev.device_type == "speaker" ? "📢" : (dev.device_type == "tv" ? "📺" : "📱");
                                font-size: 18px;
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: dev.name;
                                    color: dev.is_active ? Theme.accent : Theme.text-primary;
                                    font-size: 13px;
                                    font-weight: 600;
                                    overflow: elide;
                                }
                                Text {
                                    text: dev.device_type == "speaker" ? "Google Cast / Connect" : "Удаленное устройство";
                                    color: Theme.text-secondary;
                                    font-size: 11px;
                                }
                            }

                            if dev.is_active : Text {
                                text: "✔";
                                color: Theme.accent;
                                font-size: 14px;
                            }
                        }

                        dev_touch := TouchArea {
                            clicked => { root.select_device(dev.id); }
                        }
                    }
                }
            }
        }
    }
}
