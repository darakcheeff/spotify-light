import { Theme, LyricLine } from "../theme.slint";

export component LyricsView inherits Rectangle {
    background: @linear-gradient(180deg, #102693 0%, #0a113c 100%);
    
    in property <[LyricLine]> lyrics: [];

    callback close_lyrics();

    Flickable {
        content-height: 900px;

        VerticalLayout {
            padding-left: 64px;
            padding-right: 64px;
            padding-top: 48px;
            padding-bottom: 96px;
            spacing: 24px;

            if root.lyrics.length == 0 : VerticalLayout {
                padding-top: 120px;
                alignment: center;
                spacing: 16px;

                Text {
                    text: "Текст песни недоступен";
                    color: #ffffff;
                    font-size: 28px;
                    font-weight: 800;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Для текущего трека слова пока не найдены";
                    color: #5267a6;
                    font-size: 16px;
                    horizontal-alignment: center;
                }
            }

            for line in root.lyrics : Text {
                text: line.text;
                color: line.is_active ? #ffffff : #5267a6;
                font-size: line.is_active ? 34px : 28px;
                font-weight: 800;
                wrap: word-wrap;
                animate color { duration: 200ms; }
                animate font-size { duration: 200ms; }
            }
        }
    }
}
