import { Theme } from "../theme.slint";

export component LoginDialog inherits Rectangle {
    background: #000000d0;
    
    in-out property <int> auth_step: 0; // 0: Options / Email, 1: Password or OTP Code
    in-out property <string> email: "";
    in-out property <string> password: "";
    in-out property <string> otp_code: "";
    in-out property <bool> is_otp_mode: false;
    in-out property <string> error_message: "";
    in-out property <bool> is_loading: false;

    callback submit_email(string);
    callback submit_password(string, string);
    callback submit_otp(string, string);
    callback login_via_browser();
    callback cancel();

    // Dialog Card
    Rectangle {
        width: 460px;
        height: 540px;
        background: Theme.background-secondary;
        border-radius: Theme.radius-large;
        border-width: 1px;
        border-color: Theme.border-color;

        VerticalLayout {
            padding: 32px;
            spacing: 16px;
            alignment: center;

            // Header
            Text {
                text: "🎧 SpotifyLight";
                color: Theme.accent;
                font-size: 26px;
                font-weight: 800;
                horizontal-alignment: center;
            }

            Text {
                text: root.auth_step == 0 ? "Вход в аккаунт" : (root.is_otp_mode ? "Вход по коду из письма" : "Введите пароль");
                color: Theme.text-primary;
                font-size: 18px;
                font-weight: 700;
                horizontal-alignment: center;
            }

            // Error banner
            if root.error_message != "" : Rectangle {
                height: 48px;
                border-radius: 6px;
                background: #e11d4822;
                border-width: 1px;
                border-color: #e11d48;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    alignment: center;

                    Text {
                        text: root.error_message;
                        color: #fda4af;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }

            // Step 0: Login Options (Recommended Browser OAuth + Legacy Password)
            if root.auth_step == 0 : VerticalLayout {
                spacing: 14px;

                // 1. Primary Recommended Button: OAuth via Browser
                Rectangle {
                    height: 50px;
                    border-radius: 25px;
                    background: oauth_touch.has-hover ? Theme.accent-hover : Theme.accent;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 10px;
                        Text {
                            text: "🌐";
                            font-size: 18px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.is_loading ? "Ожидание подтверждения..." : "Войти через браузер (В 1 клик)";
                            color: #000000;
                            font-size: 14px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    oauth_touch := TouchArea {
                        clicked => {
                            if !root.is_loading {
                                root.error_message = "";
                                root.is_loading = true;
                                root.login_via_browser();
                            }
                        }
                    }
                }

                Text {
                    text: "Рекомендуется: работает со всеми аккаунтами (Google, Apple, Facebook, почта)";
                    color: Theme.text-secondary;
                    font-size: 11px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                // Divider
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    Rectangle { height: 1px; horizontal-stretch: 1; background: Theme.border-color; }
                    Text { text: "или через логин и пароль"; color: Theme.text-muted; font-size: 11px; }
                    Rectangle { height: 1px; horizontal-stretch: 1; background: Theme.border-color; }
                }

                // Email field
                VerticalLayout {
                    spacing: 6px;
                    Text { text: "Электронная почта или имя пользователя:"; color: Theme.text-secondary; font-size: 12px; }

                    Rectangle {
                        height: 42px;
                        border-radius: 4px;
                        background: Theme.background-elevated;
                        border-width: 1px;
                        border-color: email_inp.has-focus ? Theme.text-primary : Theme.border-color;

                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px;
                            email_inp := TextInput {
                                text <=> root.email;
                                color: Theme.text-primary;
                                font-size: 14px;
                                vertical-alignment: center;
                                accepted => {
                                    if root.email != "" {
                                        root.auth_step = 1;
                                        root.error_message = "";
                                        root.submit_email(root.email);
                                    } else {
                                        root.error_message = "Введите адрес эл. почты или имя пользователя";
                                    }
                                }
                            }
                        }
                    }
                }

                // Button "Продолжить с паролем"
                Rectangle {
                    height: 40px;
                    border-radius: 20px;
                    background: cont_touch.has-hover ? Theme.background-hover : Theme.background-elevated;
                    border-width: 1px;
                    border-color: Theme.border-color;

                    Text {
                        text: "Продолжить с паролем";
                        color: Theme.text-primary;
                        font-size: 13px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    cont_touch := TouchArea {
                        clicked => {
                            if root.email != "" {
                                root.auth_step = 1;
                                root.error_message = "";
                                root.submit_email(root.email);
                            } else {
                                root.error_message = "Введите адрес эл. почты или имя пользователя";
                            }
                        }
                    }
                }
            }

            // Step 1: Input Password or Email OTP Info
            if root.auth_step == 1 : VerticalLayout {
                spacing: 14px;

                HorizontalLayout {
                    Text { text: "Аккаунт: "; color: Theme.text-secondary; font-size: 12px; }
                    Text { text: root.email; color: Theme.text-primary; font-size: 12px; font-weight: 700; }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 80px;
                        height: 20px;
                        Text {
                            text: "← Изменить";
                            color: Theme.accent;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => {
                                root.auth_step = 0;
                                root.error_message = "";
                            }
                        }
                    }
                }

                // OTP Explainer Mode
                if root.is_otp_mode : VerticalLayout {
                    spacing: 10px;

                    Rectangle {
                        border-radius: 6px;
                        background: #1e3a8a33;
                        border-width: 1px;
                        border-color: #3b82f6;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            Text {
                                text: "ℹ️ Почему не приходит письмо:";
                                color: #93c5fd;
                                font-size: 12px;
                                font-weight: 700;
                            }
                            Text {
                                text: "Spotify отправляет код на почту только при входе через официальный веб-сайт. Нажмите кнопку ниже — откроется сайт Spotify, вышлет код на вашу почту и сразу выполнит вход в SpotifyLight.";
                                color: #e2e8f0;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    Rectangle {
                        height: 44px;
                        border-radius: 22px;
                        background: oauth_otp.has-hover ? Theme.accent-hover : Theme.accent;

                        Text {
                            text: root.is_loading ? "Подключение..." : "Войти через браузер";
                            color: #000000;
                            font-size: 14px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        oauth_otp := TouchArea {
                            clicked => {
                                root.error_message = "";
                                root.is_loading = true;
                                root.login_via_browser();
                            }
                        }
                    }
                }

                // Password Mode
                if !root.is_otp_mode : VerticalLayout {
                    spacing: 8px;
                    Text { text: "Пароль учетной записи:"; color: Theme.text-secondary; font-size: 12px; }

                    Rectangle {
                        height: 44px;
                        border-radius: 4px;
                        background: Theme.background-elevated;
                        border-width: 1px;
                        border-color: pwd_inp.has-focus ? Theme.text-primary : Theme.border-color;

                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px;
                            pwd_inp := TextInput {
                                text <=> root.password;
                                input-type: InputType.password;
                                color: Theme.text-primary;
                                font-size: 14px;
                                vertical-alignment: center;
                                accepted => {
                                    if root.password != "" {
                                        root.is_loading = true;
                                        root.error_message = "";
                                        root.submit_password(root.email, root.password);
                                    } else {
                                        root.error_message = "Введите пароль";
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 44px;
                        border-radius: 22px;
                        background: submit_touch.has-hover ? Theme.accent-hover : Theme.accent;

                        Text {
                            text: root.is_loading ? "Подключение..." : "Войти";
                            color: #000000;
                            font-size: 14px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        submit_touch := TouchArea {
                            clicked => {
                                if !root.is_loading {
                                    if root.password != "" {
                                        root.is_loading = true;
                                        root.error_message = "";
                                        root.submit_password(root.email, root.password);
                                    } else {
                                        root.error_message = "Введите пароль";
                                    }
                                }
                            }
                        }
                    }
                }

                // Switch between password and info mode
                Rectangle {
                    height: 24px;
                    Text {
                        text: root.is_otp_mode ? "← Вернуться к вводу пароля" : "Нет пароля? Вход по одноразовому коду";
                        color: Theme.text-secondary;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => {
                            root.is_otp_mode = !root.is_otp_mode;
                            root.error_message = "";
                        }
                    }
                }
            }

            // Cancel / Close
            Rectangle {
                height: 28px;
                Text {
                    text: "Отмена";
                    color: Theme.text-secondary;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea { clicked => { root.cancel(); } }
            }
        }
    }
}
