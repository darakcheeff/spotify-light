import { Theme } from "../theme.slint";

export component TopBar inherits Rectangle {
    height: 64px;
    background: Theme.background;
    
    in-out property <string> search_text: "";
    in-out property <bool> is_authenticated: false;
    in-out property <string> user_name: "";
    in-out property <bool> is_home_active: true;
    
    callback nav_back();
    callback nav_forward();
    callback nav_home();
    callback open_browse();
    callback search_changed(string);
    callback profile_clicked();
    callback notifications_clicked();

    HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        spacing: 16px;
        alignment: center;

        // Navigation History (Back / Forward)
        HorizontalLayout {
            spacing: 8px;
            alignment: center;
            
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: nav_back_touch.has-hover ? Theme.background-hover : Theme.background-secondary;
                
                Text {
                    text: "‹";
                    color: Theme.text-primary;
                    font-size: 18px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                
                nav_back_touch := TouchArea {
                    clicked => { root.nav_back(); }
                }
            }

            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: nav_fwd_touch.has-hover ? Theme.background-hover : Theme.background-secondary;
                
                Text {
                    text: "›";
                    color: Theme.text-primary;
                    font-size: 18px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                
                nav_fwd_touch := TouchArea {
                    clicked => { root.nav_forward(); }
                }
            }
        }

        // Home button (matching official Spotify Desktop)
        Rectangle {
            width: 44px;
            height: 44px;
            border-radius: 22px;
            background: home_touch.has-hover ? Theme.background-hover : (root.is_home_active ? #ffffff : Theme.background-elevated);

            Text {
                text: "⌂";
                color: (root.is_home_active && !home_touch.has-hover) ? #000000 : Theme.text-primary;
                font-size: 26px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            home_touch := TouchArea {
                clicked => { root.nav_home(); }
            }
        }

        // Search Bar with Integrated Browse ("Обзор") Button
        Rectangle {
            width: 460px;
            height: 44px;
            border-radius: 22px;
            background: Theme.background-elevated;
            border-width: 1px;
            border-color: search_input.has-focus ? Theme.text-primary : Theme.border-color;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 12px;
                spacing: 10px;
                alignment: center;

                Text {
                    text: "🔍";
                    font-size: 16px;
                    vertical-alignment: center;
                }

                search_input := TextInput {
                    text <=> root.search_text;
                    color: Theme.text-primary;
                    font-size: 14px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    edited => {
                        root.search_changed(self.text);
                    }
                }

                if root.search_text == "" : Text {
                    text: "Что хочешь включить?";
                    color: Theme.text-muted;
                    font-size: 14px;
                    vertical-alignment: center;
                }

                // Vertical Divider
                Rectangle {
                    width: 1px;
                    height: 20px;
                    background: #3e3e3e;
                }

                // Browse ("Обзор") Button
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 16px;
                    background: browse_touch.has-hover ? #383838 : transparent;

                    Text {
                        text: "🗂";
                        font-size: 16px;
                        color: browse_touch.has-hover ? Theme.text-primary : Theme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    browse_touch := TouchArea {
                        clicked => { root.open_browse(); }
                    }
                }
            }
        }

        // Spacer
        Rectangle { horizontal-stretch: 1; }

        // Right side: Notifications, Profile / Login
        HorizontalLayout {
            spacing: 12px;
            alignment: center;

            if root.is_authenticated : Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: bell_touch.has-hover ? Theme.background-hover : transparent;
                
                Text {
                    text: "🔔";
                    font-size: 15px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                
                bell_touch := TouchArea {
                    clicked => { root.notifications_clicked(); }
                }
            }

            // User Avatar when logged in
            if root.is_authenticated : Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: #535353;
                border-width: 2px;
                border-color: avatar_touch.has-hover ? Theme.text-primary : transparent;

                Text {
                    text: root.user_name != "" ? root.user_name : "U";
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                avatar_touch := TouchArea {
                    clicked => { root.profile_clicked(); }
                }
            }

            // "Войти" button when unauthenticated
            if !root.is_authenticated : Rectangle {
                width: 90px;
                height: 36px;
                border-radius: 18px;
                background: login_btn_touch.has-hover ? Theme.accent-hover : Theme.accent;

                Text {
                    text: "Войти";
                    color: #000000;
                    font-size: 13px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                login_btn_touch := TouchArea {
                    clicked => { root.profile_clicked(); }
                }
            }
        }
    }
}
