import { Theme, TrackItem } from "../theme.slint";

export component AlbumView inherits Rectangle {
    background: transparent;
    
    in property <string> album_title: "";
    in property <string> album_type: "Плейлист";
    in property <string> album_desc: "";
    in property <string> album_creator: "Spotify";
    in property <image> album_cover;
    in property <bool> has_album_cover: false;
    
    in property <[TrackItem]> tracks: [];

    callback play_all();
    callback track_clicked(string);
    callback track_context_menu(string, string, bool, length, length);
    callback album_context_menu(length, length);
    callback like_track(string);

    Flickable {
        content-height: (root.tracks.length * 56px) + 440px;

        VerticalLayout {
            alignment: start;

            // 1. Hero Header with Gradient (matching Spotify 7.png / 8.png)
            Rectangle {
                height: 260px;
                background: @linear-gradient(180deg, #1e3a8a 0%, #121212 100%);

                HorizontalLayout {
                    padding-left: 32px;
                    padding-right: 32px;
                    padding-bottom: 24px;
                    spacing: 24px;
                    alignment: start;

                    // Cover Art
                    Rectangle {
                        y: parent.height - self.height - 24px;
                        width: 180px;
                        height: 180px;
                        border-radius: 6px;
                        background: #0f172a;
                        drop-shadow-blur: 24px;
                        drop-shadow-color: #000000;
                        clip: true;

                        Image {
                            width: 100%;
                            height: 100%;
                            source: root.album_cover;
                            image-fit: cover;
                            visible: root.has_album_cover;
                        }

                        Text {
                            text: "♪";
                            color: Theme.accent;
                            font-size: 54px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            visible: !root.has_album_cover;
                        }
                    }

                    // Metadata
                    VerticalLayout {
                        alignment: end;
                        spacing: 8px;

                        Text {
                            text: root.album_type;
                            color: Theme.text-primary;
                            font-size: 13px;
                            font-weight: 700;
                        }

                        Text {
                            text: root.album_title != "" ? root.album_title : "Медиатека";
                            color: Theme.text-primary;
                            font-size: 40px;
                            font-weight: 900;
                            overflow: elide;
                        }

                        Text {
                            text: "Треков: " + root.tracks.length;
                            color: Theme.text-secondary;
                            font-size: 13px;
                            font-weight: 500;
                        }
                    }
                }
            }

            // 2. Actions Bar (Play, Shuffle, Like, More)
            if root.tracks.length > 0 : Rectangle {
                height: 72px;
                background: Theme.background;

                HorizontalLayout {
                    padding-left: 32px;
                    padding-right: 32px;
                    spacing: 24px;

                    // Big Green Play Button
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 52px;
                        height: 52px;
                        border-radius: 26px;
                        background: big_play.has-hover ? Theme.accent-hover : Theme.accent;

                        Text {
                            text: "▶";
                            color: #000000;
                            font-size: 22px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        big_play := TouchArea {
                            clicked => { root.play_all(); }
                        }
                    }

                    Text {
                        text: "🔀";
                        font-size: 22px;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "⊕";
                        font-size: 26px;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "↓";
                        font-size: 22px;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 32px;
                        height: 32px;
                        border-radius: 16px;
                        background: more_touch.has-hover ? #3e3e3e : transparent;

                        Text {
                            text: "•••";
                            font-size: 20px;
                            color: Theme.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        more_touch := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => { root.album_context_menu(480px, 320px); }
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Text {
                        text: "Список :≡";
                        color: Theme.text-secondary;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }

            // 3. Empty State when no tracks
            if root.tracks.length == 0 : VerticalLayout {
                padding: 48px;
                spacing: 12px;
                alignment: center;

                Text {
                    text: root.album_title != "" ? "В этом плейлисте пока нет треков" : "Выберите плейлист слева в медиатеке";
                    color: Theme.text-primary;
                    font-size: 18px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                Text {
                    text: "После выбора треки появятся здесь";
                    color: Theme.text-secondary;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }

            // 4. Track List Table
            if root.tracks.length > 0 : VerticalLayout {
                padding-left: 32px;
                padding-right: 32px;
                padding-bottom: 32px;
                spacing: 4px;

                // Table Header
                VerticalLayout {
                    spacing: 6px;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 16px;

                        Text { width: 36px; text: "#"; color: Theme.text-secondary; font-size: 12px; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: "Название"; color: Theme.text-secondary; font-size: 12px; vertical-alignment: center; }
                        Text { width: 180px; text: "Альбом"; color: Theme.text-secondary; font-size: 12px; vertical-alignment: center; }
                        Text { width: 60px; text: "🕒"; color: Theme.text-secondary; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.border-color;
                    }
                }

                // Table Rows
                for trk in root.tracks : Rectangle {
                    height: 56px;
                    border-radius: 4px;
                    background: trk.is_playing ? Theme.background-elevated : (row_touch.has-hover ? Theme.background-hover : transparent);

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 16px;

                        // Index or Play Icon
                        Text {
                            width: 36px;
                            text: trk.is_playing ? "▶" : trk.index;
                            color: trk.is_playing ? Theme.accent : Theme.text-secondary;
                            font-size: 13px;
                            font-weight: trk.is_playing ? 700 : 500;
                            vertical-alignment: center;
                        }

                        // Thumbnail artwork + Title + Artist
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            spacing: 12px;

                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 40px;
                                height: 40px;
                                border-radius: 4px;
                                background: #282828;
                                clip: true;

                                if trk.has_cover : Image {
                                    width: 100%;
                                    height: 100%;
                                    source: trk.cover;
                                    image-fit: cover;
                                }

                                if !trk.has_cover : Text {
                                    text: "♪";
                                    color: Theme.accent;
                                    font-size: 18px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: trk.title;
                                    color: trk.is_playing ? Theme.accent : Theme.text-primary;
                                    font-size: 14px;
                                    font-weight: 600;
                                    overflow: elide;
                                }
                                Text {
                                    text: trk.artist;
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                            }
                        }

                        // Album name
                        Text {
                            width: 180px;
                            text: trk.album != "" ? trk.album : root.album_title;
                            color: Theme.text-secondary;
                            font-size: 13px;
                            overflow: elide;
                            vertical-alignment: center;
                        }

                        // Duration
                        Text {
                            width: 60px;
                            text: trk.duration_str != "" ? trk.duration_str : "3:24";
                            color: Theme.text-secondary;
                            font-size: 13px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }

                    row_touch := TouchArea {
                        clicked => { root.track_clicked(trk.id); }
                        pointer-event(event) => {
                            if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                                root.track_context_menu(trk.id, trk.title, trk.is_liked, 380px, Math.min(Math.max(120px, (trk.index * 56px) + 260px), 620px));
                            }
                        }
                    }
                }
            }
        }
    }
}
