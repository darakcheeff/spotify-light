import { Theme, PlaylistItem } from "../theme.slint";

export component Sidebar inherits Rectangle {
    width: 280px;
    background: Theme.background-secondary;
    border-radius: Theme.radius-medium;
    
    in property <[PlaylistItem]> playlists: [];
    in property <bool> is_authenticated: false;
    in-out property <int> selected_filter: 0; // 0: Все, 1: Плейлисты, 2: Подкасты, 3: Альбомы, 4: Исполнители
    
    callback create_clicked();
    callback filter_selected(int);
    callback playlist_selected(string);
    callback login_clicked();

    VerticalLayout {
        padding: 12px;
        spacing: 12px;

        // Header: "Моя медиатека" + "+ Создать"
        HorizontalLayout {
            alignment: center;
            
            Text {
                text: "Моя медиатека";
                color: Theme.text-primary;
                font-size: 16px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            if root.is_authenticated : Rectangle {
                width: 90px;
                height: 32px;
                border-radius: 16px;
                background: create_touch.has-hover ? Theme.background-hover : Theme.background-elevated;

                HorizontalLayout {
                    alignment: center;
                    spacing: 4px;
                    
                    Text {
                        text: "+ Создать";
                        color: Theme.text-primary;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                create_touch := TouchArea {
                    clicked => { root.create_clicked(); }
                }
            }
        }

        // Filter chips: Все, Плейлисты, Подкасты, Альбомы, Исполнители
        HorizontalLayout {
            spacing: 6px;
            
            for filter_name[idx] in ["Все", "Плейлисты", "Альбомы", "Артисты"] : Rectangle {
                height: 28px;
                border-radius: 14px;
                background: root.selected_filter == idx ? Theme.text-primary : (chip_touch.has-hover ? Theme.background-hover : Theme.background-elevated);
                
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    
                    Text {
                        text: filter_name;
                        color: root.selected_filter == idx ? Theme.background : Theme.text-primary;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                chip_touch := TouchArea {
                    clicked => {
                        root.selected_filter = idx;
                        root.filter_selected(idx);
                    }
                }
            }
        }

        // Search & Sort bar
        HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            alignment: center;

            Text {
                text: "🔍";
                font-size: 14px;
                color: Theme.text-secondary;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            Text {
                text: "Недавние ☰";
                font-size: 12px;
                color: Theme.text-secondary;
                font-weight: 500;
                vertical-alignment: center;
            }
        }

        // Playlists list inside Flickable
        if root.playlists.length > 0 : Flickable {
            vertical-stretch: 1;
            content-height: root.playlists.length * 60px;
            
            VerticalLayout {
                spacing: 4px;

                for item in root.playlists : Rectangle {
                    height: 56px;
                    border-radius: Theme.radius-small;
                    background: item.is_active ? Theme.background-elevated : (item_touch.has-hover ? Theme.background-hover : transparent);

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 12px;
                        alignment: center;

                        Rectangle {
                            width: 44px;
                            height: 44px;
                            border-radius: 4px;
                            background: item.is_pinned ? #331f54 : #282828;

                            Text {
                                text: item.is_pinned ? "♥" : "♪";
                                color: item.is_pinned ? #a855f7 : Theme.text-secondary;
                                font-size: 18px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;

                            Text {
                                text: item.title;
                                color: item.is_active ? Theme.accent : Theme.text-primary;
                                font-size: 14px;
                                font-weight: 600;
                                overflow: elide;
                            }

                            Text {
                                text: item.subtitle;
                                color: Theme.text-secondary;
                                font-size: 12px;
                                overflow: elide;
                            }
                        }

                        if item.is_pinned : Text {
                            text: "📌";
                            font-size: 12px;
                            color: Theme.accent;
                            vertical-alignment: center;
                        }
                    }

                    item_touch := TouchArea {
                        clicked => { root.playlist_selected(item.id); }
                    }
                }
            }
        }

        // Empty state when unauthenticated or empty library
        if root.playlists.length == 0 : VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 12px;

            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 64px;
                    height: 64px;
                    border-radius: 32px;
                    background: Theme.background-elevated;

                    Text {
                        text: "♪";
                        font-size: 28px;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Text {
                text: root.is_authenticated ? "В медиатеке пока пусто" : "Войдите в аккаунт";
                color: Theme.text-primary;
                font-size: 14px;
                font-weight: 700;
                horizontal-alignment: center;
            }

            Text {
                text: root.is_authenticated ? "Создайте плейлист или сохраните треки" : "чтобы увидеть плейлисты и треки";
                color: Theme.text-secondary;
                font-size: 12px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            if !root.is_authenticated : HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 140px;
                    height: 36px;
                    border-radius: 18px;
                    background: Theme.accent;

                    Text {
                        text: "Войти";
                        color: #000000;
                        font-size: 13px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea { clicked => { root.login_clicked(); } }
                }
            }
        }
    }
}
