import { Theme, PlaylistItem } from "../theme.slint";

struct MixCard {
    title: string,
    subtitle: string,
    color: color,
    text_color: color,
    badge_color: color,
    icon_str: string,
}

export component HomeView inherits Rectangle {
    background: transparent;
    
    in property <bool> is_authenticated: false;
    in property <[PlaylistItem]> playlists: [];
    in-out property <int> selected_chip: 0; // 0: Все, 1: Музыка, 2: Подкасты, 3: Аудиокниги

    callback play_card(string);
    callback open_album(string);
    callback login_clicked();

    property <[MixCard]> daily_mixes: [
        { title: "Микс дня #1", subtitle: "Ундервуд, БИРТМАН, Мельница и не только", color: #1e3a5f, text_color: #000000, badge_color: #14d8cc, icon_str: "🎸" },
        { title: "Микс дня #2", subtitle: "Airbourne, Dogma, Halestorm и не только", color: #4a1525, text_color: #000000, badge_color: #f59b23, icon_str: "⚡" },
        { title: "Микс дня #3", subtitle: "Йорш, Порнофильмы, Другой Ветер и не только", color: #3b1b54, text_color: #ffffff, badge_color: #ff4632, icon_str: "🔥" },
        { title: "Микс дня #4", subtitle: "Plamenev, Марко Поло, Louna и не только", color: #1e453e, text_color: #ffffff, badge_color: #b02897, icon_str: "✨" }
    ];

    Flickable {
        content-height: 980px;

        VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 16px;
            padding-bottom: 40px;
            spacing: 24px;
            alignment: start;

            // 1. Top Category Chips (Все, Музыка, Подкасты, Аудиокниги)
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                for chip_text[idx] in ["Все", "Музыка", "Подкасты", "Аудиокниги"] : Rectangle {
                    height: 32px;
                    border-radius: 16px;
                    background: root.selected_chip == idx ? Theme.text-primary : (chip_t.has-hover ? Theme.background-hover : Theme.background-elevated);

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        Text {
                            text: chip_text;
                            color: root.selected_chip == idx ? Theme.background : Theme.text-primary;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    chip_t := TouchArea {
                        clicked => { root.selected_chip = idx; }
                    }
                }
            }

            // 2. Unauthenticated Banner
            if !root.is_authenticated : Rectangle {
                height: 320px;
                border-radius: Theme.radius-large;
                background: @linear-gradient(135deg, #1e3a8a 0%, #0f172a 100%);

                VerticalLayout {
                    padding: 40px;
                    spacing: 16px;
                    alignment: center;

                    Text {
                        text: "Музыка без тормозов и без Electron";
                        color: #ffffff;
                        font-size: 28px;
                        font-weight: 800;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "Войдите в аккаунт Spotify, чтобы получить доступ к своим плейлистам, рекомендациям и любимым трекам.";
                        color: #cbd5e1;
                        font-size: 15px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 180px;
                            height: 48px;
                            border-radius: 24px;
                            background: login_btn.has-hover ? Theme.accent-hover : Theme.accent;

                            Text {
                                text: "Войти в Spotify";
                                color: #000000;
                                font-size: 15px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            login_btn := TouchArea {
                                clicked => { root.login_clicked(); }
                            }
                        }
                    }
                }
            }

            // 3. Quick Access 2x4 Grid (matching official Spotify Desktop 5.png & 9.png)
            if root.is_authenticated && root.playlists.length > 0 : VerticalLayout {
                spacing: 12px;

                for row_idx in 2 : HorizontalLayout {
                    spacing: 12px;
                    height: 58px;

                    for col_idx in 4 : Rectangle {
                        property <int> p_idx: row_idx * 4 + col_idx;
                        property <PlaylistItem> pl: p_idx < root.playlists.length ? root.playlists[p_idx] : { id: "", title: "", subtitle: "", is_pinned: false, is_active: false, item_type: 0, image_url: "" };
                        property <bool> is_valid: pl.id != "";
                        property <bool> is_liked_folder: pl.item_type == 3;
                        property <bool> is_killshot: pl.item_type == 4;
                        property <bool> is_offline: pl.item_type == 1;

                        width: (parent.width - 36px) / 4;
                        height: 58px;
                        border-radius: 4px;
                        background: card_touch.has-hover ? #383838 : #282828;
                        visible: is_valid;
                        clip: true;

                        HorizontalLayout {
                            padding-right: 12px;
                            spacing: 12px;

                            // Left square artwork with authentic badges
                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 58px;
                                height: 58px;
                                border-radius: 4px;
                                background: is_liked_folder ? @linear-gradient(135deg, #450af5 0%, #8e8ee5 100%) :
                                            (is_killshot ? @linear-gradient(135deg, #ff007f 0%, #330066 100%) :
                                            (is_offline ? @linear-gradient(135deg, #b91c1c 0%, #450a0a 100%) :
                                            @linear-gradient(135deg, #1e3a8a 0%, #172554 100%)));

                                Text {
                                    text: is_liked_folder ? "♥" : (is_killshot ? "🎯" : (is_offline ? "📥" : "♪"));
                                    color: #ffffff;
                                    font-size: is_liked_folder ? 22px : 20px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            // Title
                            Text {
                                horizontal-stretch: 1;
                                text: pl.title;
                                color: Theme.text-primary;
                                font-size: 13px;
                                font-weight: 700;
                                overflow: elide;
                                vertical-alignment: center;
                            }

                            // Hover Play Button
                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 36px;
                                height: 36px;
                                border-radius: 18px;
                                background: Theme.accent;
                                visible: card_touch.has-hover;

                                Text {
                                    text: "▶";
                                    color: #000000;
                                    font-size: 14px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        card_touch := TouchArea {
                            clicked => { root.open_album(pl.id); }
                        }
                    }
                }
            }

            // 4. Section "Для тебя" (Daily Mixes / Recommendations matching 5.png & 9.png)
            if root.is_authenticated : VerticalLayout {
                spacing: 14px;

                HorizontalLayout {
                    Text {
                        text: "Для тебя";
                        color: Theme.text-primary;
                        font-size: 22px;
                        font-weight: 800;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "Показать все";
                        color: Theme.text-secondary;
                        font-size: 13px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 16px;

                    for mix in root.daily_mixes : Rectangle {
                        horizontal-stretch: 1;
                        height: 250px;
                        border-radius: Theme.radius-medium;
                        background: mix_touch.has-hover ? #242424 : #181818;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 10px;
                            alignment: start;

                            // Artwork box with authentic Daily Mix design
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 150px;
                                border-radius: 6px;
                                background: mix.color;
                                clip: true;

                                // Subtle watermark icon in background
                                Text {
                                    x: (parent.width - 60px) / 2;
                                    y: 20px;
                                    text: mix.icon_str;
                                    font-size: 50px;
                                }

                                // Spotify logo on top-left
                                Text {
                                    x: 10px;
                                    y: 8px;
                                    text: "SPOTIFY";
                                    color: #ffffff99;
                                    font-size: 10px;
                                    font-weight: 900;
                                }

                                // Bottom colored badge strip matching 9.png
                                Rectangle {
                                    y: parent.height - 28px;
                                    width: parent.width;
                                    height: 28px;
                                    background: mix.badge_color;

                                    Text {
                                        x: 8px;
                                        y: 5px;
                                        text: mix.title;
                                        color: mix.text_color;
                                        font-size: 12px;
                                        font-weight: 800;
                                    }
                                }
                            }

                            Text {
                                text: mix.title;
                                color: Theme.text-primary;
                                font-size: 14px;
                                font-weight: 700;
                                overflow: elide;
                            }

                            Text {
                                text: mix.subtitle;
                                color: Theme.text-secondary;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }

                        mix_touch := TouchArea {
                            clicked => {
                                if (root.playlists.length > 0) {
                                    root.open_album(root.playlists[0].id);
                                }
                            }
                        }
                    }
                }
            }

            // 5. Section "Недавние" (Recent library items matching 5.png & 9.png)
            if root.is_authenticated && root.playlists.length > 4 : VerticalLayout {
                spacing: 14px;

                HorizontalLayout {
                    Text {
                        text: "Недавние";
                        color: Theme.text-primary;
                        font-size: 22px;
                        font-weight: 800;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "Показать все";
                        color: Theme.text-secondary;
                        font-size: 13px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 16px;

                    for idx in 4 : Rectangle {
                        property <int> p_idx: idx + 4;
                        property <PlaylistItem> pl: p_idx < root.playlists.length ? root.playlists[p_idx] : { id: "", title: "", subtitle: "", is_pinned: false, is_active: false, item_type: 0, image_url: "" };
                        property <bool> is_valid: pl.id != "";
                        property <bool> is_liked: pl.item_type == 3;

                        width: (parent.width - 48px) / 4;
                        height: 250px;
                        border-radius: Theme.radius-medium;
                        background: rec_touch.has-hover ? #242424 : #181818;
                        visible: is_valid;
                        clip: true;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 10px;
                            alignment: start;

                            // Artwork box
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 150px;
                                border-radius: 6px;
                                background: is_liked ? @linear-gradient(135deg, #450af5 0%, #8e8ee5 100%) : #282828;

                                Text {
                                    text: is_liked ? "♥" : "♪";
                                    color: is_liked ? #ffffff : Theme.accent;
                                    font-size: 36px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                // Radio badge if it's a radio playlist
                                if pl.item_type == 4 : Rectangle {
                                    x: parent.width - 56px;
                                    y: 8px;
                                    width: 48px;
                                    height: 18px;
                                    border-radius: 3px;
                                    background: #000000aa;
                                    Text {
                                        text: "РАДИО";
                                        color: #ffffff;
                                        font-size: 9px;
                                        font-weight: 800;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            Text {
                                text: pl.title;
                                color: Theme.text-primary;
                                font-size: 14px;
                                font-weight: 700;
                                overflow: elide;
                            }

                            Text {
                                text: pl.subtitle;
                                color: Theme.text-secondary;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }

                        rec_touch := TouchArea {
                            clicked => { root.open_album(pl.id); }
                        }
                    }
                }
            }
        }
    }
}
