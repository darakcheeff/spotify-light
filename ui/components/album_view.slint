import { Theme, TrackItem } from "../theme.slint";

export component AlbumView inherits Rectangle {
    background: transparent;
    
    in property <string> album_title: "";
    in property <string> album_type: "Плейлист";
    in property <string> album_desc: "";
    
    in property <[TrackItem]> tracks: [];

    callback play_all();
    callback track_clicked(string);
    callback track_context_menu(string, length, length);
    callback like_track(string);

    Flickable {
        content-height: (root.tracks.length * 56px) + 420px;

        VerticalLayout {
            // 1. Hero Header with Gradient
            Rectangle {
                height: 280px;
                background: @linear-gradient(180deg, #1e3a8a 0%, #121212 100%);

                HorizontalLayout {
                    padding-left: 32px;
                    padding-right: 32px;
                    padding-bottom: 24px;
                    spacing: 28px;
                    alignment: end;

                    // Cover Art
                    Rectangle {
                        width: 192px;
                        height: 192px;
                        border-radius: 6px;
                        background: #0f172a;
                        drop-shadow-blur: 32px;
                        drop-shadow-color: #000000;

                        Text {
                            text: root.album_title != "" ? "♪" : "";
                            color: Theme.accent;
                            font-size: 48px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Metadata
                    VerticalLayout {
                        alignment: end;
                        spacing: 8px;

                        Text {
                            text: root.album_type;
                            color: Theme.text-primary;
                            font-size: 13px;
                            font-weight: 700;
                        }

                        Text {
                            text: root.album_title != "" ? root.album_title : "Медиатека";
                            color: Theme.text-primary;
                            font-size: 44px;
                            font-weight: 900;
                            overflow: elide;
                        }

                        Text {
                            text: root.album_desc != "" ? root.album_desc : "Треков: " + root.tracks.length;
                            color: Theme.text-secondary;
                            font-size: 13px;
                            font-weight: 500;
                        }
                    }
                }
            }

            // 2. Actions Bar (Play, Shuffle, Like, More)
            if root.tracks.length > 0 : Rectangle {
                height: 84px;
                background: Theme.background;

                HorizontalLayout {
                    padding-left: 32px;
                    padding-right: 32px;
                    spacing: 24px;
                    alignment: center;

                    // Big Green Play Button
                    Rectangle {
                        width: 56px;
                        height: 56px;
                        border-radius: 28px;
                        background: big_play.has-hover ? Theme.accent-hover : Theme.accent;

                        Text {
                            text: "▶";
                            color: #000000;
                            font-size: 24px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        big_play := TouchArea { clicked => { root.play_all(); } }
                    }

                    Text { text: "🔀"; font-size: 24px; color: Theme.text-secondary; }
                    Text { text: "⊕"; font-size: 28px; color: Theme.text-secondary; }
                    Text { text: "↓"; font-size: 24px; color: Theme.text-secondary; }
                    Text { text: "•••"; font-size: 24px; color: Theme.text-secondary; }

                    Rectangle { horizontal-stretch: 1; }

                    Text {
                        text: "Список :≡";
                        color: Theme.text-secondary;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }

            // 3. Empty State when no tracks
            if root.tracks.length == 0 : VerticalLayout {
                padding: 48px;
                spacing: 12px;
                alignment: center;

                Text {
                    text: root.album_title != "" ? "В этом плейлисте пока нет треков" : "Выберите плейлист слева в медиатеке";
                    color: Theme.text-primary;
                    font-size: 18px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                Text {
                    text: "После выбора или воспроизведения треки появятся здесь";
                    color: Theme.text-secondary;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }

            // 4. Track List Table
            if root.tracks.length > 0 : VerticalLayout {
                padding-left: 32px;
                padding-right: 32px;
                padding-bottom: 32px;
                spacing: 8px;

                // Table Header
                VerticalLayout {
                    spacing: 6px;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 16px;
                        alignment: center;

                        Text { width: 30px; text: "#"; color: Theme.text-secondary; font-size: 12px; }
                        Text { horizontal-stretch: 1; text: "Название"; color: Theme.text-secondary; font-size: 12px; }
                        Text { width: 140px; text: "Прослушивания"; color: Theme.text-secondary; font-size: 12px; }
                        Text { width: 60px; text: "🕒"; color: Theme.text-secondary; font-size: 12px; horizontal-alignment: right; }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.border-color;
                    }
                }

                // Table Rows
                for trk in root.tracks : Rectangle {
                    height: 54px;
                    border-radius: 4px;
                    background: trk.is_playing ? Theme.background-elevated : (row_touch.has-hover ? Theme.background-hover : transparent);

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 16px;
                        alignment: center;

                        // Index or Play Icon
                        Text {
                            width: 30px;
                            text: trk.is_playing ? "▶" : trk.index;
                            color: trk.is_playing ? Theme.accent : Theme.text-secondary;
                            font-size: 13px;
                            font-weight: trk.is_playing ? 700 : 500;
                        }

                        // Title + Artist
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;

                            Text {
                                text: trk.title;
                                color: trk.is_playing ? Theme.accent : Theme.text-primary;
                                font-size: 14px;
                                font-weight: 600;
                                overflow: elide;
                            }
                            Text {
                                text: trk.artist;
                                color: Theme.text-secondary;
                                font-size: 12px;
                                overflow: elide;
                            }
                        }

                        // Play count
                        Text {
                            width: 140px;
                            text: trk.play_count_str;
                            color: Theme.text-secondary;
                            font-size: 13px;
                        }

                        // Like mark
                        Text {
                            text: trk.is_liked ? "✔" : "";
                            color: Theme.accent;
                            font-size: 14px;
                        }

                        // Duration
                        Text {
                            width: 50px;
                            text: trk.duration_str;
                            color: Theme.text-secondary;
                            font-size: 13px;
                            horizontal-alignment: right;
                        }
                    }

                    row_touch := TouchArea {
                        clicked => { root.track_clicked(trk.id); }
                    }
                }
            }
        }
    }
}
