import { Theme, TrackItem, PlaylistItem, DeviceItem, LyricLine } from "theme.slint";
import { TopBar } from "components/top_bar.slint";
import { Sidebar } from "components/sidebar.slint";
import { PlayerBar } from "components/player_bar.slint";
import { RightDrawer } from "components/right_drawer.slint";
import { HomeView } from "components/home_view.slint";
import { AlbumView } from "components/album_view.slint";
import { BrowseView } from "components/browse_view.slint";
import { SettingsView } from "components/settings_view.slint";
import { ProfileMenu } from "components/profile_menu.slint";
import { LyricsView } from "components/lyrics_view.slint";
import { LoginDialog } from "components/login_dialog.slint";
import { ContextMenu } from "components/context_menu.slint";

export component AppWindow inherits Window {
    title: "spotify-light";
    icon: @image-url("../assets/icon.png");
    min-width: 960px;
    min-height: 640px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.background;
    default-font-family: Theme.font-family;

    in-out property <bool> is_authenticated: false;
    in-out property <string> user_display_name: "";
    in-out property <string> user_initial: "L";
    in-out property <string> auth_error: "";
    in-out property <bool> auth_loading: false;

    in-out property <int> current_workspace: 0; // 0: Home, 1: Album/Playlist, 2: Browse, 3: Settings
    in-out property <bool> is_lyrics_open: false;
    in-out property <bool> is_drawer_open: false;
    in-out property <int> drawer_mode: 0; // 0: Queue, 1: Connect Devices
    in-out property <bool> is_login_open: false;
    in-out property <bool> is_profile_menu_open: false;
    in-out property <bool> is_context_menu_open: false;
    in-out property <int> context_menu_type: 0; // 0: Playlist, 1: Track, 2: Album, 3: Artist
    in-out property <string> context_menu_id: "";
    in-out property <string> context_menu_title: "";
    in-out property <bool> context_menu_is_liked: false;
    in-out property <length> context_menu_x: 200px;
    in-out property <length> context_menu_y: 200px;

    // Real dynamic collections
    in-out property <[PlaylistItem]> user_playlists: [];
    in-out property <string> current_album_title: "";
    in-out property <[TrackItem]> current_tracks: [];
    in-out property <[TrackItem]> recent_items: [];
    in-out property <[DeviceItem]> discovered_devices: [];

    // Track playback state (synchronized with Audio Engine via event loop)
    in-out property <string> active_track_title: "";
    in-out property <string> active_track_artist: "";
    in-out property <string> current_time: "0:00";
    in-out property <string> total_time: "0:00";
    in-out property <float> track_progress: 0.0;
    in-out property <bool> is_playing: false;
    in-out property <bool> is_liked: false;
    in-out property <float> current_volume: 0.8;

    // Navigation history for Back / Forward
    in-out property <int> history_index: 0;

    // Callbacks to Rust backend
    callback play_pause();
    callback next_track();
    callback prev_track();
    callback seek_position(float);
    callback change_volume(float);
    callback select_connect_device(string);
    callback search_query(string);
    callback library_search_query(string);
    callback select_playlist(string);
    callback filter_library(int);
    callback play_track(string);
    callback email_submitted(string);
    callback login_requested(string, string);
    callback otp_submitted(string, string);
    callback browser_login_requested();
    callback logout_requested();
    callback add_to_queue(string);
    callback toggle_like_track(string);
    callback copy_to_clipboard(string);
    callback delete_playlist(string);
    callback create_new_playlist();
    callback add_track_to_playlist(string, string);

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // 1. Top Navigation Bar (Centered search, authentic browse drawer icon, profile menu)
        TopBar {
            is_authenticated: root.is_authenticated;
            user_name: root.user_display_name;
            user_initial: root.user_initial;
            is_home_active: root.current_workspace == 0;
            nav_back => {
                if root.current_workspace > 0 {
                    root.current_workspace = 0;
                }
            }
            nav_home => {
                root.current_workspace = 0;
                root.is_lyrics_open = false;
            }
            open_browse => {
                root.current_workspace = 2;
                root.is_lyrics_open = false;
            }
            search_changed(query) => {
                root.search_query(query);
            }
            profile_clicked => {
                if root.is_authenticated {
                    root.is_profile_menu_open = !root.is_profile_menu_open;
                } else {
                    root.is_login_open = true;
                }
            }
        }

        // 2. Middle Area (Sidebar + Persistent Workspaces + Right Drawer)
        HorizontalLayout {
            vertical-stretch: 1;
            padding-left: 8px;
            padding-right: 8px;
            spacing: 8px;

            // Left Sidebar
            Sidebar {
                is_authenticated: root.is_authenticated;
                playlists: root.user_playlists;
                filter_selected(idx) => {
                    root.filter_library(idx);
                }
                playlist_selected(id) => {
                    root.current_workspace = 1;
                    root.is_lyrics_open = false;
                    root.select_playlist(id);
                }
                playlist_context_menu(id, x, y) => {
                    root.context_menu_type = 0;
                    root.context_menu_id = id;
                    root.context_menu_x = x;
                    root.context_menu_y = y;
                    root.is_context_menu_open = true;
                }
                create_clicked => {
                    root.create_new_playlist();
                }
                library_search_changed(q) => {
                    root.library_search_query(q);
                }
                login_clicked => {
                    root.is_login_open = true;
                }
            }

            // Central Workspace Stack
            Rectangle {
                horizontal-stretch: 1;
                border-radius: Theme.radius-medium;
                clip: true;

                // View 1: Karaoke / Lyrics (on top when active)
                if root.is_lyrics_open : LyricsView {
                    close_lyrics => { root.is_lyrics_open = false; }
                }

                // View 2: Home Catalog (matching 5.png & 9.png)
                if !root.is_lyrics_open && root.current_workspace == 0 : HomeView {
                    is_authenticated: root.is_authenticated;
                    playlists: root.user_playlists;
                    open_album(id) => {
                        root.current_workspace = 1;
                        root.select_playlist(id);
                    }
                    login_clicked => { root.is_login_open = true; }
                }

                // View 3: Album / Playlist View (matching 7.png / 8.png)
                if !root.is_lyrics_open && root.current_workspace == 1 : AlbumView {
                    album_title: root.current_album_title;
                    tracks: root.current_tracks;
                    play_all => {
                        if (root.current_tracks.length > 0) {
                            root.play_track(root.current_tracks[0].id);
                        }
                    }
                    track_clicked(id) => { root.play_track(id); }
                    track_context_menu(id, title, is_liked, x, y) => {
                        root.context_menu_type = 1;
                        root.context_menu_id = id;
                        root.context_menu_title = title;
                        root.context_menu_is_liked = is_liked;
                        root.context_menu_x = x;
                        root.context_menu_y = y;
                        root.is_context_menu_open = true;
                    }
                    album_context_menu(x, y) => {
                        root.context_menu_type = 2;
                        root.context_menu_id = "";
                        root.context_menu_x = x;
                        root.context_menu_y = y;
                        root.is_context_menu_open = true;
                    }
                    like_track(id) => {
                        root.toggle_like_track(id);
                    }
                }

                // View 4: Browse / Обзор View (matching 6.png)
                if !root.is_lyrics_open && root.current_workspace == 2 : BrowseView {
                    category_clicked(name) => {
                        root.search_query(name);
                    }
                }

                // View 5: Settings / Настройки View with Equalizer (matching 10.png - 14.png)
                if !root.is_lyrics_open && root.current_workspace == 3 : SettingsView {
                    eq_changed(band, db) => {
                        // Forward to audio engine if needed
                    }
                }
            }

            // Right Drawer (Queue / Recently Played / Connect Devices)
            if root.is_drawer_open : RightDrawer {
                mode: root.drawer_mode;
                devices: root.discovered_devices;
                queue_items: root.current_tracks;
                recent_items: root.recent_items;
                close_drawer => { root.is_drawer_open = false; }
                select_device(id) => { root.select_connect_device(id); }
                play_queue_item(id) => { root.play_track(id); }
            }
        }

        // 3. Bottom Player Bar (Single source of truth)
        PlayerBar {
            track_title: root.active_track_title;
            track_artist: root.active_track_artist;
            current_time_str: root.current_time;
            total_time_str: root.total_time;
            progress: root.track_progress;
            is_playing: root.is_playing;
            is_liked: root.is_liked;
            volume: root.current_volume;
            
            lyrics_open: root.is_lyrics_open;
            queue_open: root.is_drawer_open && root.drawer_mode == 0;
            devices_open: root.is_drawer_open && root.drawer_mode == 1;

            play_pause_clicked => {
                root.is_playing = !root.is_playing;
                root.play_pause();
            }
            next_clicked => { root.next_track(); }
            prev_clicked => { root.prev_track(); }
            seek(val) => {
                root.track_progress = val;
                root.seek_position(val);
            }
            volume_changed(val) => {
                root.current_volume = val;
                root.change_volume(val);
            }
            toggle_lyrics => {
                root.is_lyrics_open = !root.is_lyrics_open;
            }
            toggle_queue => {
                if root.is_drawer_open && root.drawer_mode == 0 {
                    root.is_drawer_open = false;
                } else {
                    root.is_drawer_open = true;
                    root.drawer_mode = 0;
                }
            }
            toggle_devices => {
                if root.is_drawer_open && root.drawer_mode == 1 {
                    root.is_drawer_open = false;
                } else {
                    root.is_drawer_open = true;
                    root.drawer_mode = 1;
                }
            }
        }
    }

    // Modal Login Dialog Overlay
    if root.is_login_open : LoginDialog {
        error_message <=> root.auth_error;
        is_loading <=> root.auth_loading;
        cancel => { root.is_login_open = false; }
        submit_email(email) => { root.email_submitted(email); }
        submit_password(email, pwd) => { root.login_requested(email, pwd); }
        submit_otp(email, code) => { root.otp_submitted(email, code); }
        login_via_browser => { root.browser_login_requested(); }
    }

    // Profile Popup Menu Overlay (matching 9.png)
    if root.is_profile_menu_open : ProfileMenu {
        close_menu => { root.is_profile_menu_open = false; }
        open_settings => {
            root.is_profile_menu_open = false;
            root.current_workspace = 3;
            root.is_lyrics_open = false;
        }
        logout => {
            root.is_profile_menu_open = false;
            root.logout_requested();
        }
    }

    // Context Menu Overlay (Playlist, Track, Album, Artist - matching official UI)
    if root.is_context_menu_open : ContextMenu {
        menu_type: root.context_menu_type;
        target_id: root.context_menu_id;
        target_title: root.context_menu_title;
        is_liked: root.context_menu_is_liked;
        menu_x: root.context_menu_x;
        menu_y: root.context_menu_y;
        playlists: root.user_playlists;
        close => { root.is_context_menu_open = false; }
        add_to_queue(id) => { root.add_to_queue(id); }
        like_toggle(id) => { root.toggle_like_track(id); }
        copy_link(id, type_idx) => { root.copy_to_clipboard(id); }
        delete_playlist(id) => { root.delete_playlist(id); }
        create_playlist => { root.create_new_playlist(); }
        add_track_to_playlist(tid, pid) => { root.add_track_to_playlist(tid, pid); }
        go_to_artist(id) => {
            root.current_workspace = 1;
            root.select_playlist(id);
        }
        go_to_album(id) => {
            root.current_workspace = 1;
            root.select_playlist(id);
        }
    }
}
