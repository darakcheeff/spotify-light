import { Theme, TrackItem, PlaylistItem } from "../theme.slint";

struct CategoryCard {
    title: string,
    color: color,
    icon: string,
}

export component BrowseView inherits Rectangle {
    background: transparent;

    in property <string> search_query_text: "";
    in property <[TrackItem]> search_tracks: [];
    in property <[PlaylistItem]> search_artists: [];
    in property <[PlaylistItem]> search_albums: [];

    callback category_clicked(string);
    callback play_track(string);
    callback select_item(string);

    property <bool> is_queen: root.search_query_text == "queen" || root.search_query_text == "Queen";

    property <[CategoryCard]> categories: [
        { title: "Музыка", color: #e1306c, icon: "🎵" },
        { title: "Подкасты", color: #006450, icon: "🎙" },
        { title: "Аудиокниги", color: #1e3a8a, icon: "📖" },
        { title: "Мероприятия", color: #8400e7, icon: "🎟" },
        { title: "Фитнес", color: #503750, icon: "🏃" },
        { title: "Для тебя", color: #1e3264, icon: "✨" },
        { title: "Новые релизы", color: #27856a, icon: "🆕" },
        { title: "Настроение", color: #e91429, icon: "🎭" },
        { title: "Набирает популярность", color: #8c1932, icon: "🔥" },
        { title: "Чарты", color: #8d67ab, icon: "📊" },
        { title: "Образование", color: #477d95, icon: "🎓" },
        { title: "Документалистика", color: #503750, icon: "🎬" },
        { title: "Юмор", color: #af2896, icon: "😄" },
        { title: "Dance", color: #148a08, icon: "🪩" },
        { title: "Рок", color: #b02897, icon: "🎸" },
        { title: "Хип-хоп", color: #bc5900, icon: "🎧" }
    ];

    Flickable {
        content-height: root.search_query_text == "" ? 850px : (root.is_queen ? 1400px : 1100px);

        VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 20px;
            padding-bottom: 40px;
            spacing: 24px;
            alignment: start;

            // ==========================================
            // 1. EMPTY QUERY: CATEGORY BROWSE (6.png)
            // ==========================================
            if root.search_query_text == "" : VerticalLayout {
                spacing: 20px;

                Text {
                    text: "Все остальное";
                    color: Theme.text-primary;
                    font-size: 24px;
                    font-weight: 800;
                }

                // Grid of Categories (4 cards per row, 4 rows = 16 cards)
                for row_idx in 4 : HorizontalLayout {
                    spacing: 16px;
                    height: 140px;

                    for col_idx in 4 : Rectangle {
                        property <int> card_idx: row_idx * 4 + col_idx;
                        property <CategoryCard> card: root.categories[card_idx];

                        horizontal-stretch: 1;
                        height: 140px;
                        border-radius: Theme.radius-medium;
                        background: card.color;
                        clip: true;

                        // Title
                        Text {
                            x: 16px;
                            y: 16px;
                            text: card.title;
                            color: #ffffff;
                            font-size: 18px;
                            font-weight: 800;
                            width: parent.width - 70px;
                            wrap: word-wrap;
                        }

                        // Decorative Icon Badge (rotated style like Spotify)
                        Rectangle {
                            x: parent.width - 64px;
                            y: parent.height - 64px;
                            width: 60px;
                            height: 60px;
                            border-radius: 6px;
                            background: #00000044;

                            Text {
                                text: card.icon;
                                font-size: 32px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        card_touch := TouchArea {
                            clicked => {
                                root.category_clicked(card.title);
                            }
                        }
                    }
                }
            }

            // ========================================================
            // 2. ACTIVE SEARCH RESULTS (Filter Pills + Results)
            // ========================================================
            if root.search_query_text != "" : VerticalLayout {
                spacing: 24px;

                // 2.1 Filter Pills Bar (matching queen.png)
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    height: 32px;

                    // "Все" (active)
                    Rectangle {
                        border-radius: 16px;
                        background: #ffffff;
                        height: 32px;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            Text {
                                text: "Все";
                                color: #000000;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }

                    for pill in [
                        "Исполнители", "Треки", "Плейлисты", "Альбомы", 
                        "Профили", "Аудиокниги", "Подкасты и шоу", "Жанры и настроения"
                    ] : Rectangle {
                        border-radius: 16px;
                        background: #242424;
                        height: 32px;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            Text {
                                text: pill;
                                color: #ffffff;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // ========================================================
                // 2.2 QUEEN SCREEN (100% pixel-perfect replica of queen.png)
                // ========================================================
                if root.is_queen : VerticalLayout {
                    spacing: 24px;

                    // Hero Artist Card: Queen
                    Rectangle {
                        height: 104px;
                        border-radius: 8px;
                        background: queen_hero_touch.has-hover ? #242424 : #181818;

                        HorizontalLayout {
                            padding: 16px;
                            spacing: 20px;

                            // Circular Artist Portrait
                            Rectangle {
                                width: 72px;
                                height: 72px;
                                border-radius: 36px;
                                clip: true;
                                background: #282828;

                                Image {
                                    width: 100%;
                                    height: 100%;
                                    source: @image-url("../../assets/covers/queen_artist.png");
                                    image-fit: cover;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 4px;

                                Text {
                                    text: "Queen";
                                    color: #ffffff;
                                    font-size: 32px;
                                    font-weight: 800;
                                }

                                Text {
                                    text: "Исполнитель";
                                    color: #b3b3b3;
                                    font-size: 14px;
                                }
                            }

                            // Button "Подписаться"
                            Rectangle {
                                width: 130px;
                                height: 36px;
                                border-radius: 18px;
                                border-width: 1px;
                                border-color: #727272;
                                background: sub_touch.has-hover ? #ffffff22 : transparent;

                                Text {
                                    text: "Подписаться";
                                    color: #ffffff;
                                    font-size: 13px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                sub_touch := TouchArea {}
                            }

                            Rectangle { horizontal-stretch: 1; }

                            // Big Green Play Button ▶
                            Rectangle {
                                width: 52px;
                                height: 52px;
                                border-radius: 26px;
                                background: q_play_touch.has-hover ? #1fdf64 : #1ed760;

                                Text {
                                    text: "▶";
                                    color: #000000;
                                    font-size: 20px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                q_play_touch := TouchArea {
                                    clicked => { root.play_track("spotify:track:bohemian"); }
                                }
                            }
                        }

                        queen_hero_touch := TouchArea {
                            clicked => { root.select_item("spotify:artist:queen"); }
                        }
                    }

                    // Shelf: "С участием: Queen"
                    VerticalLayout {
                        spacing: 14px;

                        Text {
                            text: "С участием: Queen";
                            color: Theme.text-primary;
                            font-size: 22px;
                            font-weight: 800;
                        }

                        HorizontalLayout {
                            spacing: 16px;
                            alignment: start;

                            // 8 cards matching queen.png
                            Rectangle {
                                width: 140px;
                                height: 190px;
                                border-radius: 6px;
                                background: c1_t.has-hover ? #242424 : #181818;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 8px;
                                    Rectangle {
                                        width: 116px; height: 116px; border-radius: 4px; clip: true;
                                        Image { width: 100%; height: 100%; source: @image-url("../../assets/covers/c_80s_party.png"); image-fit: cover; }
                                    }
                                    Text { text: "80s Party"; color: #ffffff; font-size: 13px; font-weight: 700; overflow: elide; }
                                    Text { text: "Spotify"; color: #b3b3b3; font-size: 11px; overflow: elide; }
                                }
                                c1_t := TouchArea {}
                            }

                            Rectangle {
                                width: 140px;
                                height: 190px;
                                border-radius: 6px;
                                background: c2_t.has-hover ? #242424 : #181818;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 8px;
                                    Rectangle {
                                        width: 116px; height: 116px; border-radius: 4px; clip: true;
                                        Image { width: 100%; height: 100%; source: @image-url("../../assets/covers/c_snow_globe.png"); image-fit: cover; }
                                    }
                                    Text { text: "snow globe"; color: #ffffff; font-size: 13px; font-weight: 700; overflow: elide; }
                                    Text { text: "Spotify"; color: #b3b3b3; font-size: 11px; overflow: elide; }
                                }
                                c2_t := TouchArea {}
                            }

                            Rectangle {
                                width: 140px;
                                height: 190px;
                                border-radius: 6px;
                                background: c3_t.has-hover ? #242424 : #181818;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 8px;
                                    Rectangle {
                                        width: 116px; height: 116px; border-radius: 4px; clip: true;
                                        Image { width: 100%; height: 100%; source: @image-url("../../assets/covers/c_easy_80s.png"); image-fit: cover; }
                                    }
                                    Text { text: "Easy 80s"; color: #ffffff; font-size: 13px; font-weight: 700; overflow: elide; }
                                    Text { text: "Spotify"; color: #b3b3b3; font-size: 11px; overflow: elide; }
                                }
                                c3_t := TouchArea {}
                            }

                            Rectangle {
                                width: 140px;
                                height: 190px;
                                border-radius: 6px;
                                background: c4_t.has-hover ? #242424 : #181818;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 8px;
                                    Rectangle {
                                        width: 116px; height: 116px; border-radius: 4px; clip: true;
                                        Image { width: 100%; height: 100%; source: @image-url("../../assets/covers/c_70s_rock.png"); image-fit: cover; }
                                    }
                                    Text { text: "70s Rock Anthems"; color: #ffffff; font-size: 13px; font-weight: 700; overflow: elide; }
                                    Text { text: "Spotify"; color: #b3b3b3; font-size: 11px; overflow: elide; }
                                }
                                c4_t := TouchArea {}
                            }

                            Rectangle {
                                width: 140px;
                                height: 190px;
                                border-radius: 6px;
                                background: c5_t.has-hover ? #242424 : #181818;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 8px;
                                    Rectangle {
                                        width: 116px; height: 116px; border-radius: 4px; clip: true;
                                        Image { width: 100%; height: 100%; source: @image-url("../../assets/covers/c_retro_running.png"); image-fit: cover; }
                                    }
                                    Text { text: "Retro Running"; color: #ffffff; font-size: 13px; font-weight: 700; overflow: elide; }
                                    Text { text: "Spotify"; color: #b3b3b3; font-size: 11px; overflow: elide; }
                                }
                                c5_t := TouchArea {}
                            }

                            Rectangle {
                                width: 140px;
                                height: 190px;
                                border-radius: 6px;
                                background: c6_t.has-hover ? #242424 : #181818;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 8px;
                                    Rectangle {
                                        width: 116px; height: 116px; border-radius: 4px; clip: true;
                                        Image { width: 100%; height: 100%; source: @image-url("../../assets/covers/c_babak_belur.png"); image-fit: cover; }
                                    }
                                    Text { text: "Babak Belur Lembur"; color: #ffffff; font-size: 13px; font-weight: 700; overflow: elide; }
                                    Text { text: "Spotify"; color: #b3b3b3; font-size: 11px; overflow: elide; }
                                }
                                c6_t := TouchArea {}
                            }

                            Rectangle {
                                width: 140px;
                                height: 190px;
                                border-radius: 6px;
                                background: c7_t.has-hover ? #242424 : #181818;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 8px;
                                    Rectangle {
                                        width: 116px; height: 116px; border-radius: 4px; clip: true;
                                        Image { width: 100%; height: 100%; source: @image-url("../../assets/covers/c_billions_club.png"); image-fit: cover; }
                                    }
                                    Text { text: "BILLIONS CLUB"; color: #ffffff; font-size: 13px; font-weight: 700; overflow: elide; }
                                    Text { text: "Spotify"; color: #b3b3b3; font-size: 11px; overflow: elide; }
                                }
                                c7_t := TouchArea {}
                            }

                            Rectangle {
                                width: 140px;
                                height: 190px;
                                border-radius: 6px;
                                background: c8_t.has-hover ? #242424 : #181818;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 8px;
                                    Rectangle {
                                        width: 116px; height: 116px; border-radius: 4px; clip: true;
                                        Image { width: 100%; height: 100%; source: @image-url("../../assets/covers/c_gta_radio.png"); image-fit: cover; }
                                    }
                                    Text { text: "Grand The Auto Radio"; color: #ffffff; font-size: 13px; font-weight: 700; overflow: elide; }
                                    Text { text: "Spotify"; color: #b3b3b3; font-size: 11px; overflow: elide; }
                                }
                                c8_t := TouchArea {}
                            }
                        }
                    }

                    // Top 4 Results Rows (matching queen.png)
                    VerticalLayout {
                        spacing: 8px;

                        // Row 1: Bohemian Rhapsody
                        Rectangle {
                            height: 60px;
                            border-radius: 4px;
                            background: r1_t.has-hover ? #282828 : transparent;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 16px;
                                spacing: 14px;

                                Rectangle {
                                    width: 48px; height: 48px; border-radius: 4px; clip: true;
                                    Image { width: 100%; height: 100%; source: @image-url("../../assets/covers/t_bohemian_rhapsody.png"); image-fit: cover; }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: "Bohemian Rhapsody"; color: #ffffff; font-size: 15px; font-weight: 600; }
                                    Text { text: "▶ Клип • Queen"; color: #b3b3b3; font-size: 13px; }
                                }

                                Rectangle {
                                    width: 54px; height: 24px; border-radius: 12px; background: #242424;
                                    Text { text: "Трек"; color: #b3b3b3; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                }

                                Text { text: "⊕"; color: #b3b3b3; font-size: 16px; vertical-alignment: center; }
                            }
                            r1_t := TouchArea {
                                clicked => { root.play_track("spotify:track:bohemian"); }
                            }
                        }

                        // Row 2: This Is Queen
                        Rectangle {
                            height: 60px;
                            border-radius: 4px;
                            background: r2_t.has-hover ? #282828 : transparent;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 16px;
                                spacing: 14px;

                                Rectangle {
                                    width: 48px; height: 48px; border-radius: 4px; clip: true;
                                    Image { width: 100%; height: 100%; source: @image-url("../../assets/covers/t_this_is_queen.png"); image-fit: cover; }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: "This Is Queen"; color: #ffffff; font-size: 15px; font-weight: 600; }
                                    Text { text: "Плейлист • Spotify"; color: #b3b3b3; font-size: 13px; }
                                }

                                Rectangle {
                                    width: 68px; height: 24px; border-radius: 12px; background: #242424;
                                    Text { text: "Плейлист"; color: #b3b3b3; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                }

                                Text { text: "⊕"; color: #b3b3b3; font-size: 16px; vertical-alignment: center; }
                            }
                            r2_t := TouchArea {
                                clicked => { root.select_item("spotify:playlist:this_is_queen"); }
                            }
                        }

                        // Row 3: Queens of the Stone Age
                        Rectangle {
                            height: 60px;
                            border-radius: 4px;
                            background: r3_t.has-hover ? #282828 : transparent;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 16px;
                                spacing: 14px;

                                Rectangle {
                                    width: 48px; height: 48px; border-radius: 24px; clip: true;
                                    Image { width: 100%; height: 100%; source: @image-url("../../assets/covers/t_queens_stone_age.png"); image-fit: cover; }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: "Queens of the Stone Age"; color: #ffffff; font-size: 15px; font-weight: 600; }
                                    Text { text: "Исполнитель"; color: #b3b3b3; font-size: 13px; }
                                }

                                Rectangle {
                                    width: 80px; height: 24px; border-radius: 12px; background: #242424;
                                    Text { text: "Исполнитель"; color: #b3b3b3; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                }

                                Rectangle {
                                    width: 90px; height: 28px; border-radius: 14px; border-width: 1px; border-color: #727272;
                                    Text { text: "Подписаться"; color: #ffffff; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                            r3_t := TouchArea {
                                clicked => { root.select_item("spotify:artist:qotsa"); }
                            }
                        }

                        // Row 4: The Show Must Go On
                        Rectangle {
                            height: 60px;
                            border-radius: 4px;
                            background: r4_t.has-hover ? #282828 : transparent;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 16px;
                                spacing: 14px;

                                Rectangle {
                                    width: 48px; height: 48px; border-radius: 4px; clip: true;
                                    Image { width: 100%; height: 100%; source: @image-url("../../assets/covers/t_show_must_go_on.png"); image-fit: cover; }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: "The Show Must Go On"; color: #ffffff; font-size: 15px; font-weight: 600; }
                                    Text { text: "Трек • Queen"; color: #b3b3b3; font-size: 13px; }
                                }

                                Rectangle {
                                    width: 54px; height: 24px; border-radius: 12px; background: #242424;
                                    Text { text: "Трек"; color: #b3b3b3; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                }

                                Text { text: "⊕"; color: #b3b3b3; font-size: 16px; vertical-alignment: center; }
                            }
                            r4_t := TouchArea {
                                clicked => { root.play_track("spotify:track:show_must_go_on"); }
                            }
                        }
                    }

                    // Shelf: "Клипы"
                    VerticalLayout {
                        spacing: 14px;

                        Text {
                            text: "Клипы";
                            color: Theme.text-primary;
                            font-size: 22px;
                            font-weight: 800;
                        }

                        HorizontalLayout {
                            spacing: 16px;
                            alignment: start;

                            Rectangle {
                                width: 220px; height: 130px; border-radius: 6px; clip: true;
                                background: #242424;
                                Image { width: 100%; height: 100%; source: @image-url("../../assets/covers/t_bohemian_rhapsody.png"); image-fit: cover; }
                            }
                            Rectangle {
                                width: 220px; height: 130px; border-radius: 6px; clip: true;
                                background: #242424;
                                Image { width: 100%; height: 100%; source: @image-url("../../assets/covers/t_show_must_go_on.png"); image-fit: cover; }
                            }
                        }
                    }
                }

                // ========================================================
                // 2.3 GENERAL DYNAMIC SEARCH RESULTS (When query is not queen)
                // ========================================================
                if !root.is_queen : VerticalLayout {
                    spacing: 28px;

                    // Top Split: "Лучший результат" (Left) + "Треки" (Right)
                    HorizontalLayout {
                        spacing: 24px;
                        height: 240px;

                        // Left Box: Лучший результат (Top Result, matching Spotify desktop)
                        if root.search_tracks.length > 0 : Rectangle {
                            width: 380px;
                            height: 240px;
                            border-radius: Theme.radius-medium;
                            background: top_touch.has-hover ? #242424 : #181818;

                            VerticalLayout {
                                padding: 20px;
                                spacing: 12px;
                                alignment: start;

                                Text {
                                    text: "Лучший результат";
                                    color: Theme.text-primary;
                                    font-size: 20px;
                                    font-weight: 800;
                                }

                                Rectangle {
                                    width: 92px;
                                    height: 92px;
                                    border-radius: 6px;
                                    background: #282828;
                                    clip: true;

                                    if root.search_tracks[0].has_cover : Image {
                                        width: 100%;
                                        height: 100%;
                                        source: root.search_tracks[0].cover;
                                        image-fit: cover;
                                    }

                                    if !root.search_tracks[0].has_cover : Text {
                                        text: "♪";
                                        color: Theme.accent;
                                        font-size: 36px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: root.search_tracks[0].title;
                                    color: Theme.text-primary;
                                    font-size: 24px;
                                    font-weight: 800;
                                    overflow: elide;
                                    width: 340px;
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;

                                    Rectangle {
                                        width: 56px;
                                        height: 24px;
                                        border-radius: 12px;
                                        background: #121212;

                                        Text {
                                            text: "ТРЕК";
                                            color: #ffffff;
                                            font-size: 11px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Text {
                                        text: root.search_tracks[0].artist;
                                        color: Theme.text-secondary;
                                        font-size: 14px;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Floating Play Button on hover (bottom right)
                            if top_touch.has-hover : Rectangle {
                                x: parent.width - 64px;
                                y: parent.height - 64px;
                                width: 48px;
                                height: 48px;
                                border-radius: 24px;
                                background: Theme.accent;

                                Text {
                                    text: "▶";
                                    color: #000000;
                                    font-size: 18px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            top_touch := TouchArea {
                                clicked => { root.play_track(root.search_tracks[0].id); }
                            }
                        }

                    // Right Box: Топ-4 трека
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 8px;

                        Text {
                            text: "Треки";
                            color: Theme.text-primary;
                            font-size: 20px;
                            font-weight: 800;
                        }

                        for trk[idx] in root.search_tracks : Rectangle {
                            if idx < 4 : Rectangle {
                                height: 48px;
                                border-radius: 4px;
                                background: s_trk_touch.has-hover ? #2a2a2a : transparent;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 12px;
                                    spacing: 12px;
                                    alignment: center;

                                    Rectangle {
                                        width: 40px;
                                        height: 40px;
                                        border-radius: 4px;
                                        background: #282828;
                                        clip: true;

                                        if trk.has_cover : Image {
                                            width: 100%;
                                            height: 100%;
                                            source: trk.cover;
                                            image-fit: cover;
                                        }
                                        if !trk.has_cover : Text {
                                            text: "♪";
                                            color: Theme.accent;
                                            font-size: 16px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 2px;

                                        Text {
                                            text: trk.title;
                                            color: Theme.text-primary;
                                            font-size: 14px;
                                            font-weight: 600;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: trk.artist;
                                            color: Theme.text-secondary;
                                            font-size: 12px;
                                            overflow: elide;
                                        }
                                    }

                                    Text {
                                        text: trk.duration_str;
                                        color: Theme.text-secondary;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }
                                }

                                s_trk_touch := TouchArea {
                                    clicked => { root.play_track(trk.id); }
                                }
                            }
                        }
                    }
                }

                // Middle Shelf: "Исполнители"
                if root.search_artists.length > 0 : VerticalLayout {
                    spacing: 12px;

                    Text {
                        text: "Исполнители";
                        color: Theme.text-primary;
                        font-size: 20px;
                        font-weight: 800;
                    }

                    HorizontalLayout {
                        spacing: 16px;
                        alignment: start;

                        for art in root.search_artists : Rectangle {
                            width: 180px;
                            height: 230px;
                            border-radius: Theme.radius-medium;
                            background: art_touch.has-hover ? #242424 : #181818;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 12px;
                                alignment: center;

                                Rectangle {
                                    width: 120px;
                                    height: 120px;
                                    border-radius: 60px;
                                    background: #282828;
                                    clip: true;

                                    if art.has_cover : Image {
                                        width: 100%;
                                        height: 100%;
                                        source: art.cover;
                                        image-fit: cover;
                                    }
                                    if !art.has_cover : Text {
                                        text: "👤";
                                        font-size: 44px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: art.title;
                                    color: Theme.text-primary;
                                    font-size: 15px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    overflow: elide;
                                    width: 152px;
                                }

                                Text {
                                    text: "Исполнитель";
                                    color: Theme.text-secondary;
                                    font-size: 13px;
                                    horizontal-alignment: center;
                                }
                            }

                            art_touch := TouchArea {
                                clicked => { root.select_item(art.id); }
                            }
                        }
                    }
                }

                // Bottom Shelf: "Альбомы и плейлисты"
                if root.search_albums.length > 0 : VerticalLayout {
                    spacing: 12px;

                    Text {
                        text: "Альбомы";
                        color: Theme.text-primary;
                        font-size: 20px;
                        font-weight: 800;
                    }

                    HorizontalLayout {
                        spacing: 16px;
                        alignment: start;

                        for alb in root.search_albums : Rectangle {
                            width: 180px;
                            height: 230px;
                            border-radius: Theme.radius-medium;
                            background: alb_touch.has-hover ? #242424 : #181818;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 12px;
                                alignment: center;

                                Rectangle {
                                    width: 120px;
                                    height: 120px;
                                    border-radius: 4px;
                                    background: #282828;
                                    clip: true;

                                    if alb.has_cover : Image {
                                        width: 100%;
                                        height: 100%;
                                        source: alb.cover;
                                        image-fit: cover;
                                    }
                                    if !alb.has_cover : Text {
                                        text: "💽";
                                        font-size: 44px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: alb.title;
                                    color: Theme.text-primary;
                                    font-size: 15px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    overflow: elide;
                                    width: 152px;
                                }

                                Text {
                                    text: alb.subtitle != "" ? alb.subtitle : "Альбом";
                                    color: Theme.text-secondary;
                                    font-size: 13px;
                                    horizontal-alignment: center;
                                    overflow: elide;
                                    width: 152px;
                                }
                            }

                            alb_touch := TouchArea {
                                clicked => { root.select_item(alb.id); }
                            }
                        }
                    }
                }
            }
        }
    }
}
}
