import { Theme } from "../theme.slint";

export component HomeView inherits Rectangle {
    background: transparent;
    
    in property <bool> is_authenticated: false;
    in-out property <int> selected_chip: 0; // 0: Все, 1: Музыка, 2: Подкасты, 3: Аудиокниги

    callback play_card(string);
    callback open_album(string);
    callback login_clicked();

    Flickable {
        content-height: 700px;

        VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 16px;
            padding-bottom: 32px;
            spacing: 24px;

            // 1. Top Category Chips
            HorizontalLayout {
                spacing: 8px;
                for chip_text[idx] in ["Все", "Музыка", "Подкасты", "Аудиокниги"] : Rectangle {
                    height: 32px;
                    border-radius: 16px;
                    background: root.selected_chip == idx ? Theme.text-primary : (chip_t.has-hover ? Theme.background-hover : Theme.background-elevated);

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        Text {
                            text: chip_text;
                            color: root.selected_chip == idx ? Theme.background : Theme.text-primary;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    chip_t := TouchArea {
                        clicked => { root.selected_chip = idx; }
                    }
                }
            }

            // 2. Unauthenticated Banner
            if !root.is_authenticated : Rectangle {
                height: 320px;
                border-radius: Theme.radius-large;
                background: @linear-gradient(135deg, #1e3a8a 0%, #0f172a 100%);

                VerticalLayout {
                    padding: 40px;
                    spacing: 16px;
                    alignment: center;

                    Text {
                        text: "Музыка без тормозов и без Electron";
                        color: #ffffff;
                        font-size: 28px;
                        font-weight: 800;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "Войдите в аккаунт Spotify, чтобы получить доступ к своим плейлистам, рекомендациям и любимым трекам.";
                        color: #cbd5e1;
                        font-size: 15px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    Rectangle {
                        width: 180px;
                        height: 48px;
                        border-radius: 24px;
                        background: login_btn.has-hover ? Theme.accent-hover : Theme.accent;
                        horizontal-alignment: center;

                        Text {
                            text: "Войти в Spotify";
                            color: #000000;
                            font-size: 15px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        login_btn := TouchArea {
                            clicked => { root.login_clicked(); }
                        }
                    }
                }
            }

            // 3. Authenticated Content Placeholder (Real library feeds)
            if root.is_authenticated : VerticalLayout {
                spacing: 20px;

                Text {
                    text: "Главная";
                    color: Theme.text-primary;
                    font-size: 24px;
                    font-weight: 800;
                }

                Text {
                    text: "Ваша музыка загружается...";
                    color: Theme.text-secondary;
                    font-size: 14px;
                }
            }
        }
    }
}
