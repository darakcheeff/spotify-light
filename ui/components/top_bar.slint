import { Theme } from "../theme.slint";

export component TopBar inherits Rectangle {
    height: 64px;
    background: Theme.background;
    
    in-out property <string> search_text: "";
    in-out property <bool> is_authenticated: false;
    in-out property <string> user_name: "";
    in-out property <string> user_initial: "L";
    in-out property <bool> is_home_active: true;
    callback nav_back();
    callback nav_forward();
    callback nav_home();
    callback open_browse();
    callback search_changed(string);
    callback profile_clicked();
    callback notifications_clicked();

    HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        spacing: 16px;

        // 1. Navigation History (Back / Forward)
        HorizontalLayout {
            spacing: 8px;
            alignment: center;
            
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: nav_back_touch.has-hover ? Theme.background-hover : Theme.background-secondary;
                
                Text {
                    text: "‹";
                    color: Theme.text-primary;
                    font-size: 18px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                
                nav_back_touch := TouchArea {
                    clicked => { root.nav_back(); }
                }
            }

            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: nav_fwd_touch.has-hover ? Theme.background-hover : Theme.background-secondary;
                
                Text {
                    text: "›";
                    color: Theme.text-primary;
                    font-size: 18px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                
                nav_fwd_touch := TouchArea {
                    clicked => { root.nav_forward(); }
                }
            }
        }

        // Left Flexible Spacer (Guarantees center alignment of Search Bar)
        Rectangle { horizontal-stretch: 1; }

        // 2. Centered Group: Home Button + Search / Browse Capsule (matching 9.png)
        HorizontalLayout {
            spacing: 8px;
            alignment: center;

            // Circular Home button
            Rectangle {
                width: 48px;
                height: 48px;
                border-radius: 24px;
                background: home_touch.has-hover ? #2a2a2a : #1f1f1f;

                Text {
                    text: "⌂";
                    color: root.is_home_active ? #ffffff : #b3b3b3;
                    font-size: 26px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                home_touch := TouchArea {
                    clicked => { root.nav_home(); }
                }
            }

            // Rounded Search Capsule with integrated Browse drawer icon
            Rectangle {
                width: 480px;
                height: 48px;
                border-radius: 24px;
                background: #1f1f1f;
                border-width: 1px;
                border-color: search_input.has-focus ? #ffffff : #2a2a2a;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 14px;
                    spacing: 10px;
                    alignment: center;

                    // Search Magnifying Glass (Pixel-perfect centered vector icon)
                    Rectangle {
                        width: 24px;
                        height: 24px;

                        // Glass ring
                        Rectangle {
                            x: 3px;
                            y: 3px;
                            width: 12px;
                            height: 12px;
                            border-radius: 6px;
                            border-width: 1.8px;
                            border-color: browse_touch.has-hover || search_input.has-focus ? #ffffff : #b3b3b3;
                            background: transparent;
                        }

                        // Glass handle (diagonal stroke)
                        Path {
                            stroke: browse_touch.has-hover || search_input.has-focus ? #ffffff : #b3b3b3;
                            stroke-width: 2px;
                            MoveTo { x: 12; y: 12; }
                            LineTo { x: 18; y: 18; }
                        }

                        TouchArea {
                            clicked => {
                                root.open_browse();
                            }
                        }
                    }

                    // Input & Placeholder
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 38px;
                        clip: true;

                        if root.search_text == "" : Text {
                            text: "Что хочешь включить?";
                            color: #8b8b8b;
                            font-size: 14px;
                            vertical-alignment: center;
                            x: 0px;
                        }

                        search_input := TextInput {
                            width: parent.width;
                            height: parent.height;
                            text <=> root.search_text;
                            color: Theme.text-primary;
                            font-size: 14px;
                            vertical-alignment: center;
                            edited => {
                                root.search_changed(self.text);
                            }
                        }
                    }

                    // Clear button '✕' (visible when search text is active, matching queen.png)
                    if root.search_text != "" : Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: clear_touch.has-hover ? #2e2e2e : transparent;

                        Text {
                            text: "✕";
                            color: clear_touch.has-hover ? #ffffff : #b3b3b3;
                            font-size: 13px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        clear_touch := TouchArea {
                            clicked => {
                                root.search_text = "";
                                root.search_changed("");
                            }
                        }
                    }

                    // Thin Vertical Separator
                    Rectangle {
                        width: 1px;
                        height: 22px;
                        background: #3e3e3e;
                    }

                    // Authentic Spotify Drawer/Browse Icon (matching 9.png)
                    Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 17px;
                        background: browse_touch.has-hover ? #2e2e2e : transparent;

                        // Vector drawer / collection icon
                        Rectangle {
                            x: (parent.width - 20px) / 2;
                            y: (parent.height - 16px) / 2;
                            width: 20px;
                            height: 16px;
                            border-radius: 2px;
                            border-width: 1.8px;
                            border-color: browse_touch.has-hover ? #ffffff : #b3b3b3;

                            // Middle shelf partition
                            Rectangle {
                                y: 7px;
                                width: parent.width;
                                height: 1.8px;
                                background: browse_touch.has-hover ? #ffffff : #b3b3b3;
                            }

                            // Bottom drawer notch / handle
                            Rectangle {
                                y: 11px;
                                x: (parent.width - 6px) / 2;
                                width: 6px;
                                height: 1.8px;
                                border-radius: 1px;
                                background: browse_touch.has-hover ? #ffffff : #b3b3b3;
                            }
                        }

                        browse_touch := TouchArea {
                            clicked => { root.open_browse(); }
                        }
                    }
                }
            }
        }

        // Right Flexible Spacer (Guarantees center alignment of Search Bar)
        Rectangle { horizontal-stretch: 1; }

        // 3. Right Group: Notifications & Profile Avatar
        HorizontalLayout {
            spacing: 14px;
            alignment: center;

            if root.is_authenticated : Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: bell_touch.has-hover ? #2a2a2a : transparent;
                
                Text {
                    text: "🔔";
                    font-size: 15px;
                    color: bell_touch.has-hover ? #ffffff : #b3b3b3;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                
                bell_touch := TouchArea {
                    clicked => { root.notifications_clicked(); }
                }
            }

            // Community / Friends icon (matching queen.png)
            if root.is_authenticated : Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: friends_touch.has-hover ? #2a2a2a : transparent;

                Text {
                    text: "👥";
                    font-size: 15px;
                    color: friends_touch.has-hover ? #ffffff : #b3b3b3;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                friends_touch := TouchArea {}
            }

            // User Avatar: Clean letter circle (no overflowing long text, matching 9.png)
            if root.is_authenticated : Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: #c86432; // Spotify copper/orange avatar color
                border-width: 2px;
                border-color: avatar_touch.has-hover ? #ffffff : transparent;

                Text {
                    text: root.user_initial;
                    color: #ffffff;
                    font-size: 14px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                avatar_touch := TouchArea {
                    clicked => {
                        root.profile_clicked();
                    }
                }
            }

            // "Войти" button when unauthenticated
            if !root.is_authenticated : Rectangle {
                width: 90px;
                height: 36px;
                border-radius: 18px;
                background: login_btn_touch.has-hover ? Theme.accent-hover : Theme.accent;

                Text {
                    text: "Войти";
                    color: #000000;
                    font-size: 13px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                login_btn_touch := TouchArea {
                    clicked => { root.profile_clicked(); }
                }
            }
        }
    }
}
